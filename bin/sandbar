#!/usr/bin/env bash
# sandbar — lifecycle wrapper for the Sandbar MCP server.
#
# Per plans/sandbar_operational_lifecycle_and_full_mcp_cutover_arc_2026_05_21.md
# Stage X.1.A.
#
# Subcommands:
#   start         — start sandbar if not running; idempotent
#   stop          — stop sandbar if running; idempotent
#   restart       — stop + start
#   status        — show running state + token + memory-count
#   rotate-token  — issue a new MCP token + persist to ~/.config/sandbar/token
#   log           — tail the server log
#   backup        — incremental Datomic backup-db to .sandbar/backups/<sid>-<TS>-...
#   restore       — restore-db from a backup dir (preflight verify; :dev keeps transactor up)
#   verify-backup — verify-backup over latest (or named) backup
#   backup-list   — enumerate backups + status
#   backup-prune  — prune backups by age/count (--keep-days N [--keep-count K] [--confirm])
#
# Configuration via env:
#   SANDBAR_HOME       — repo root (default: $HOME/src/sandbar)
#   SANDBAR_CLIENT_DIR — client-project root (default: $HOME/claude)
#                        Per decisions/sandbar_deployment_consumption_cohabitability_strategy_2026_05_24.md D.A
#                        Propagated to JVM as -Dsandbar.client-dir=<path>
#   SANDBAR_PORT       — MCP port (default: 8389; was 8080 pre-2026-05-24).
#                        Layer 3 of the 3-layer config; overrides
#                        <SANDBAR_CLIENT_DIR>/.sandbar/config.edn :port
#   SANDBAR_TOKEN      — bearer token (overrides ~/.config/sandbar/token)

set -euo pipefail

# This local read-only command must precede configuration/token handling and
# mkdir. It never contacts the service or changes the chosen tree.
if [ "${1:-}" = "verify-export" ]; then
  shift
  if ! command -v bb >/dev/null 2>&1; then
    echo "verify-export: Babashka (bb) is required" >&2
    exit 2
  fi
  verifier_home="${SANDBAR_HOME:-$HOME/src/sandbar}"
  exec bb "${verifier_home}/bin/verify-export.bb" "$@"
fi

# The diagnostic reads existing client configuration only; no implicit mkdir.
if [ "${1:-}" = "recovery-check" ]; then
  shift
  if ! command -v bb >/dev/null 2>&1; then
    echo "recovery-check: Babashka (bb) is required" >&2
    exit 2
  fi
  recovery_home="${SANDBAR_HOME:-$HOME/src/sandbar}"
  exec bb "${recovery_home}/bin/recovery-check.bb" "$@"
fi

SANDBAR_HOME="${SANDBAR_HOME:-$HOME/src/sandbar}"
SANDBAR_CLIENT_DIR="${SANDBAR_CLIENT_DIR:-$HOME/claude}"
SANDBAR_CONFIG="${SANDBAR_CLIENT_DIR}/.sandbar"
SANDBAR_PID_FILE="${SANDBAR_CONFIG}/sandbar.pid"
SANDBAR_LOG_FILE="${SANDBAR_CONFIG}/sandbar.log"
SANDBAR_TOKEN_FILE="${SANDBAR_CONFIG}/token"
# Port resolution — walk the layered config (Tier 3 env > Tier 2 client
# .sandbar/config.edn > Tier 1 bundled config/config.edn > 8389 fallback).
# Per F.1 follow-up of memory/observations/phase_3b_mm_event_lift_-
# migration_complete_gate2_verified_with_3_followups_2026_05_24.md —
# without this, env-default 8389 mismatched the Tier-2-pinned 8080 JVM
# and bin/sandbar status/stop missed the running JVM entirely.
if [ -z "${SANDBAR_PORT:-}" ]; then
  for cfg in "${SANDBAR_CONFIG}/config.edn" "${SANDBAR_HOME}/config/config.edn"; do
    if [ -f "$cfg" ]; then
      p=$(grep -E '^\s*:port[[:space:]]+[0-9]+' "$cfg" 2>/dev/null | head -1 | grep -oE '[0-9]+' || true)
      if [ -n "$p" ]; then
        SANDBAR_PORT="$p"
        break
      fi
    fi
  done
fi
SANDBAR_PORT="${SANDBAR_PORT:-8389}"

# Export so the JVM sees them via System/getenv + as JVM props
export SANDBAR_CLIENT_DIR SANDBAR_PORT
export JVM_OPTS="${JVM_OPTS:-} -Dsandbar.client-dir=$SANDBAR_CLIENT_DIR"

mkdir -p "$SANDBAR_CONFIG"

# A successful sentinel is "port is listening on a process".  We prefer
# the live port-listener (authoritative) but fall back to PID-file-if-
# alive when port resolution might be wrong (e.g., user override
# mismatches reality, or transactor changed ports unexpectedly).  The
# PID-file fallback uses `kill -0` for liveness — never echoes a stale
# PID.  Per F.1 follow-up (2026-05-24).
# The lsof lookup is restricted to the LISTENING socket (2026-09-19): the
# unfiltered form listed every process with a socket on the port, clients
# included, and took the first — right after a restart it named the
# session's mcp-remote bridge instead of the server, and `stop` would have
# killed that client first and then force-killed the JVM (bugs/bin_sandbar_-
# running_pid_takes_the_first_process_on_the_port_... 2026-09-19).  The
# listener stays FIRST on purpose: `stop` must signal the java process, not
# the lein wrapper shell the PID file records.
running_pid() {
  local pid=$(lsof -nP -iTCP:"$SANDBAR_PORT" -sTCP:LISTEN -t 2>/dev/null | head -1)
  if [ -n "$pid" ]; then
    echo "$pid"
    return
  fi
  # Fallback: PID file pointing at a live process.
  if [ -f "$SANDBAR_PID_FILE" ]; then
    local file_pid=$(cat "$SANDBAR_PID_FILE" 2>/dev/null)
    if [ -n "$file_pid" ] && kill -0 "$file_pid" 2>/dev/null; then
      echo "$file_pid"
      return
    fi
  fi
}

resolve_token() {
  if [ -n "${SANDBAR_TOKEN:-}" ]; then
    echo "$SANDBAR_TOKEN"
  elif [ -f "$SANDBAR_TOKEN_FILE" ]; then
    cat "$SANDBAR_TOKEN_FILE"
  fi
}

cmd="${1:-status}"

case "$cmd" in
  start)
    pid=$(running_pid || true)
    if [ -n "$pid" ]; then
      echo "sandbar already running on port $SANDBAR_PORT (PID $pid)"
      exit 0
    fi
    cd "$SANDBAR_HOME"
    nohup lein run > "$SANDBAR_LOG_FILE" 2>&1 &
    new_pid=$!
    echo "$new_pid" > "$SANDBAR_PID_FILE"
    echo "starting sandbar (PID $new_pid) — log: $SANDBAR_LOG_FILE"
    # Wait for ready — server answers ANY HTTP code on /mcp once Pedestal
    # is up.  Polling at 1s for up to 90s (lein cold-start typical ~30s).
    ready=0
    for i in $(seq 1 90); do
      code=$(curl -s -o /dev/null -w "%{http_code}" "http://localhost:$SANDBAR_PORT/mcp" 2>/dev/null || true)
      if [ -n "$code" ] && [ "$code" != "000" ]; then
        echo "sandbar ready after ${i}s (HTTP $code)"
        ready=1
        break
      fi
      sleep 1
    done
    if [ "$ready" != "1" ]; then
      echo "sandbar failed to become ready within 90s" >&2
      echo "last 10 lines of $SANDBAR_LOG_FILE:" >&2
      tail -10 "$SANDBAR_LOG_FILE" >&2
      exit 1
    fi
    # X.1.B fresh-DB auto-init — per plans/sandbar_operational_lifecycle_-
    # and_full_mcp_cutover_arc_2026_05_21.md + decisions/restore_sandbar_-
    # from_durable_git_export_at_memory_open_never_rely_on_db_durability_-
    # 2026_05_12.md.  Datomic is transient; filesystem (git-tracked) is
    # canonical.  At each start, if the DB is empty, project memory/ into
    # it via sandbar.project.import.  Idempotent — never re-imports a
    # populated DB.
    # Need a token to make MCP calls.  If we have one (env or cached
    # file), use it.  Otherwise SKIP fresh-init + warn — the user can
    # issue a token via `sandbar rotate-token` then re-run start (or
    # invoke `sandbar init` separately).  Auto-issuing the token here
    # would require a second lein cold-start (~30s) which makes the
    # common-case start path slow.
    token=$(resolve_token)
    if [ -z "$token" ]; then
      echo "no MCP token present — skipping fresh-init check"
      echo "to enable auto-import: 'sandbar rotate-token corpus <key>' then 'sandbar init'"
      exit 0
    fi
    # Check entity count
    body='{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"sandbar.aggregate.count","arguments":{"class":":mm/Memory"}}}'
    cnt=$(curl -s -X POST "http://localhost:$SANDBAR_PORT/mcp" \
          -H "Authorization: Bearer $token" \
          -H "Content-Type: application/json" \
          -d "$body" 2>/dev/null | grep -oE 'count[\\"]+ *: *[0-9]+' | head -1 | grep -oE '[0-9]+' || echo 0)
    if [ "${cnt:-0}" = "0" ]; then
      corpus_root="${SANDBAR_CORPUS_ROOT:-$HOME/claude}"
      echo "DB is empty — auto-importing ${corpus_root}/memory/ ..."
      import_body=$(cat <<EOF
{"jsonrpc":"2.0","id":2,"method":"tools/call","params":{"name":"sandbar.project.import","arguments":{"from":"${corpus_root}","filter":{"tree-filter":"memory/"},"persist?":true}}}
EOF
)
      result=$(curl -s -X POST "http://localhost:$SANDBAR_PORT/mcp" \
               --max-time 600 \
               -H "Authorization: Bearer $token" \
               -H "Content-Type: application/json" \
               -d "$import_body" 2>/dev/null)
      imported=$(echo "$result" | grep -oE 'imported[\\"]+ *: *[0-9]+' | head -1 | grep -oE '[0-9]+' || echo 0)
      groups=$(echo "$result" | grep -oE 'groups[\\"]+ *: *[0-9]+' | head -1 | grep -oE '[0-9]+' || echo 0)
      failed=$(echo "$result" | grep -oE 'failed-count[\\"]+ *: *[0-9]+' | head -1 | grep -oE '[0-9]+' || echo 0)
      echo "auto-import complete: $imported entities across $groups memorials ($failed failed)"
    else
      echo "DB has $cnt :mm/Memory entities — skipping auto-import"
    fi
    exit 0
    ;;

  stop)
    pid=$(running_pid || true)
    if [ -z "$pid" ]; then
      echo "sandbar not running"
      rm -f "$SANDBAR_PID_FILE"
      exit 0
    fi
    echo "stopping sandbar (PID $pid)"
    kill "$pid" 2>/dev/null || true
    for i in $(seq 1 30); do
      pid=$(running_pid || true)
      if [ -z "$pid" ]; then
        echo "sandbar stopped after ${i}s"
        rm -f "$SANDBAR_PID_FILE"
        exit 0
      fi
      sleep 1
    done
    pid=$(running_pid || true)
    if [ -n "$pid" ]; then
      echo "force-killing PID $pid" >&2
      kill -9 "$pid" 2>/dev/null || true
    fi
    rm -f "$SANDBAR_PID_FILE"
    ;;

  restart)
    "$0" stop
    "$0" start
    ;;

  status)
    pid=$(running_pid || true)
    if [ -n "$pid" ]; then
      echo "RUNNING — port $SANDBAR_PORT (PID $pid)"
      token=$(resolve_token)
      if [ -n "$token" ]; then
        echo "TOKEN  — present ($([ -f "$SANDBAR_TOKEN_FILE" ] && echo "$SANDBAR_TOKEN_FILE" || echo 'env'))"
        body='{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"sandbar.aggregate.count","arguments":{"class":":mm/Memory"}}}'
        # Inner text is JSON-encoded, so the `"count"` shows up as
        # `\"count\"` in the response bytes.  Match either form.
        cnt=$(curl -s -X POST "http://localhost:$SANDBAR_PORT/mcp" \
              -H "Authorization: Bearer $token" \
              -H "Content-Type: application/json" \
              -d "$body" 2>/dev/null | grep -oE 'count[\\"]+ *: *[0-9]+' | head -1 | grep -oE '[0-9]+' || true)
        if [ -n "$cnt" ]; then
          echo "MEMORY — $cnt :mm/Memory entities in DB"
        else
          echo "MEMORY — could not read (token rejected? db empty?)"
        fi
      else
        echo "TOKEN  — MISSING (run 'sandbar rotate-token corpus <key>')"
      fi
    else
      echo "STOPPED — port $SANDBAR_PORT free"
    fi
    ;;

  rotate-token)
    service="${2:-corpus}"
    key="${3:-default-$(date +%s)}"
    cd "$SANDBAR_HOME"
    out=$(lein issue-mcp-token "$service" "$key" --rotate 2>&1)
    echo "$out"
    new_token=$(echo "$out" | grep -oE 'SANDBAR_TOKEN="[^"]+"' | head -1 | sed 's/.*"\(.*\)"/\1/')
    if [ -n "$new_token" ]; then
      echo "$new_token" > "$SANDBAR_TOKEN_FILE"
      chmod 600 "$SANDBAR_TOKEN_FILE"
      echo "token written to $SANDBAR_TOKEN_FILE"
    else
      echo "warning: could not extract token from issue-mcp-token output" >&2
      exit 1
    fi
    ;;

  export)
    # Guarded project export (W1.H first build, approved 2026-09-21):
    #
    #   sandbar export <dir> --project <ident> --destination <name> \
    #                  [--execute --expect-plan <token>] [--provenance]
    #
    # Thin wrapper over the `sandbar.project.export` MCP verb.  The
    # default is a PREVIEW (dry-run true): the server plans on one
    # database basis, writes a private audit and returns counts, the
    # basis and a plan token — no staging output.  `--execute` sends
    # dry-run false and MUST carry the preview's token; the server
    # re-plans and refuses when the basis, selection or destination
    # moved.  <dir> is the `to` argument: an absolute path naming a
    # fresh direct child of the named destination's staging root, which
    # the SERVER creates (this wrapper never mkdirs it); the exported
    # files land at <dir>/<rel-path>, so <dir> is the document tree root
    # and can be used directly as an import `from`.
    #
    # Response decoding (contract 2026-09-21): transport failure,
    # non-JSON body, JSON-RPC `error` and MCP `isError` are each decoded
    # BEFORE any data field is read; an execute whose status is not
    # `complete` with `complete? true` is a failure; the preview token is
    # printed verbatim; no count is ever printed as "complete" unless the
    # server said so.  Decoding uses Babashka (bb), the project's own
    # scripting runtime; without it the raw response is kept in a file and
    # the command fails rather than guessing.
    shift
    export_dir=""
    export_project=""
    export_destination=""
    export_execute=0
    export_expect_plan=""
    export_provenance=0
    export_usage() {
      echo "usage: sandbar export <dir> --project <ident> --destination <name> [--execute --expect-plan <token>] [--provenance]" >&2
    }
    while [ $# -gt 0 ]; do
      case "$1" in
        --project)
          [ $# -ge 2 ] || { echo "export: --project needs a value" >&2; export_usage; exit 2; }
          export_project="$2"; shift 2 ;;
        --destination)
          [ $# -ge 2 ] || { echo "export: --destination needs a value" >&2; export_usage; exit 2; }
          export_destination="$2"; shift 2 ;;
        --expect-plan)
          [ $# -ge 2 ] || { echo "export: --expect-plan needs a value" >&2; export_usage; exit 2; }
          export_expect_plan="$2"; shift 2 ;;
        --execute)    export_execute=1; shift ;;
        --provenance) export_provenance=1; shift ;;
        --canonical)
          echo "export: --canonical is no longer supported; the guarded export writes only to a fresh child of an operator-configured staging root" >&2
          exit 2 ;;
        -h|--help)    export_usage; exit 0 ;;
        --*)
          echo "export: unknown option $1" >&2; export_usage; exit 2 ;;
        *)
          if [ -z "$export_dir" ]; then export_dir="$1"; shift
          else echo "export: unexpected argument $1" >&2; export_usage; exit 2; fi ;;
      esac
    done
    if [ -z "$export_dir" ] || [ -z "$export_project" ] || [ -z "$export_destination" ]; then
      echo "export: <dir>, --project and --destination are required" >&2
      export_usage; exit 2
    fi
    case "$export_dir" in
      /*) ;;
      *)  echo "export: <dir> must be an absolute path (a fresh child of the destination's staging root)" >&2; exit 2 ;;
    esac
    if [ "$export_execute" -eq 1 ] && [ -z "$export_expect_plan" ]; then
      echo "export: --execute requires --expect-plan <token> from a preview of the same arguments" >&2
      exit 2
    fi
    if [ "$export_execute" -eq 0 ] && [ -n "$export_expect_plan" ]; then
      echo "export: --expect-plan only applies with --execute (a preview mints the token)" >&2
      exit 2
    fi
    if ! command -v bb >/dev/null 2>&1; then
      echo "export: babashka (bb) is required to build and decode the export request; install it or run the MCP verb sandbar.project.export directly" >&2
      exit 2
    fi
    pid=$(running_pid || true)
    if [ -z "$pid" ]; then
      echo "sandbar not running — start it first ('sandbar start')" >&2
      exit 1
    fi
    token=$(resolve_token)
    if [ -z "$token" ]; then
      echo "no MCP token resolvable — set SANDBAR_TOKEN or 'sandbar rotate-token corpus <key>'" >&2
      exit 1
    fi
    if [ "$export_execute" -eq 1 ]; then export_dry_run=false; else export_dry_run=true; fi
    # Build the JSON-RPC body with a real JSON encoder (no shell interpolation
    # into JSON): dry-run is a JSON boolean, expect-plan a string, provenance
    # only when requested.
    export_body=$(bb -e '
      (require (quote [cheshire.core :as json]))
      (let [[to project destination dry-run expect-plan provenance] *command-line-args*
            args (cond-> {:to to :project project :destination destination
                          :dry-run (= "true" dry-run)}
                   (seq expect-plan) (assoc :expect-plan expect-plan)
                   (= "1" provenance) (assoc :provenance true))]
        (println (json/generate-string {:jsonrpc "2.0" :id 1 :method "tools/call"
                                        :params {:name "sandbar_project_export" :arguments args}})))' \
      -- "$export_dir" "$export_project" "$export_destination" "$export_dry_run" "$export_expect_plan" "$export_provenance")
    if [ -z "$export_body" ]; then
      echo "export: could not build the request" >&2
      exit 2
    fi
    export_resp="$(mktemp "${TMPDIR:-/tmp}/sandbar-export-resp.XXXXXX")"
    if [ "$export_execute" -eq 1 ]; then
      echo "export: executing plan ${export_expect_plan} → ${export_dir} (project ${export_project}, destination ${export_destination})"
    else
      echo "export: previewing ${export_dir} (project ${export_project}, destination ${export_destination}); the server writes a private audit only, no staging output"
    fi
    set +e
    export_http=$(curl -s -o "$export_resp" -w '%{http_code}' -X POST "http://localhost:$SANDBAR_PORT/mcp" \
                  --max-time 900 \
                  -H "Authorization: Bearer $token" \
                  -H "Content-Type: application/json" \
                  -d "$export_body" 2>/dev/null)
    export_curl_exit=$?
    set -e
    if [ "$export_curl_exit" -ne 0 ]; then
      echo "export: transport failure (curl exit $export_curl_exit); nothing can be concluded about the export" >&2
      rm -f "$export_resp"
      exit 1
    fi
    # Decode in one place, in order: HTTP status, JSON body, JSON-RPC error,
    # MCP isError (refusal), then the data fields.  Prints the operator
    # lines; the exit code is the verdict (0 only for a preview or a
    # complete execution).
    set +e
    bb -e '
      (require (quote [cheshire.core :as json]) (quote [clojure.string :as str]))
      (let [[resp-file http-code mode] *command-line-args*
            fail (fn [code & lines] (doseq [l lines] (binding [*out* *err*] (println l))) (System/exit code))
            raw (slurp resp-file)
            body (try (json/parse-string raw true) (catch Exception _ ::unparseable))]
        (when-not (re-matches #"2\d\d" (str http-code))
          (fail 1 (str "export: server answered HTTP " http-code "; no data was read (raw response kept at " resp-file ")")))
        (when (= ::unparseable body)
          (fail 1 (str "export: the response was not JSON; no data was read (raw response kept at " resp-file ")")))
        (when-let [err (:error body)]
          (fail 1 (str "export: JSON-RPC error " (:code err) (when (:message err) (str ": " (:message err))))))
        (let [result (:result body)
              text (get-in result [:content 0 :text])
              ;; MCP results may carry the payload as structuredContent (an
              ;; object) and/or as the first text content item (JSON text);
              ;; prefer the structured form, fall back to the text.
              structured (:structuredContent result)
              payload (cond (map? structured) structured
                            (string? text) (try (json/parse-string text true) (catch Exception _ ::unparseable))
                            :else nil)]
          (when (nil? result)
            (fail 1 "export: the response carried neither a result nor an error; nothing was concluded"))
          (when (true? (:isError result))
            (let [reason (or (get-in payload [:details :reason]) (get-in payload [:details :sandbar/error]))
                  message (if (map? payload) (:message payload) (when (string? text) text))]
              (fail 1 (str "export: refused" (when reason (str " (" (name (keyword (str reason))) ")")) (when message (str " — " message)))
                      "export: inspect the operator configuration or the private audit; no output was accepted")))
          (when (or (= ::unparseable payload) (not (map? payload)))
            (fail 1 (str "export: the tool result could not be decoded; no data was read (raw response kept at " resp-file ")")))
          (let [status (some-> (:status payload) str (str/replace #"^:" ""))
                complete? (true? (:complete? payload))
                token (:plan-token payload)
                show (fn [k label] (when (contains? payload k) (println (str "  " label ": " (get payload k)))))]
            (println (str "export: status " (or status "unknown")))
            (show :basis "basis")
            (show :included-count "included")
            (show :held-count "held (see the private audit)")
            (show :exported-count "exported")
            (show :audit-ref "audit-ref")
            (when (contains? payload :provenance-recorded?) (println (str "  provenance recorded: " (:provenance-recorded? payload))))
            (when (contains? payload :reason) (println (str "  reason: " (:reason payload))))
            (cond
              (= mode "preview")
              (if (and (= status "preview") (string? token))
                (do (println (str "  plan-token: " token))
                    (println "export: preview only — a private audit was written under the audit root of the destination; nothing was written to the staging destination; re-run with --execute --expect-plan <plan-token> to write")
                    (System/exit 0))
                (fail 1 (str "export: expected a preview with a plan token, got status " (or status "unknown") "; no output was accepted")))
              :else
              (if (and (= status "complete") complete?)
                (do (println (str "export: complete — " (or (:exported-count payload) "?") " documents written; export-manifest.edn is the completion marker"))
                    (System/exit 0))
                (fail 1 (str "export: NOT complete (status " (or status "unknown") ", complete? " complete? "); any partial output has no valid completion manifest and must not be published")))))))' \
      -- "$export_resp" "$export_http" "$([ "$export_execute" -eq 1 ] && echo execute || echo preview)"
    export_verdict=$?
    set -e
    if [ "$export_verdict" -eq 0 ]; then
      rm -f "$export_resp"
    fi
    exit "$export_verdict"
    ;;

  init)
    # X.1.B fresh-DB auto-init.  Idempotent — invokes sandbar.project.import
    # ONLY if the DB has zero :mm/Memory entities.  Requires sandbar to be
    # running + a token resolvable (env OR cached file).
    pid=$(running_pid || true)
    if [ -z "$pid" ]; then
      echo "sandbar not running — start it first ('sandbar start')" >&2
      exit 1
    fi
    token=$(resolve_token)
    if [ -z "$token" ]; then
      echo "no MCP token resolvable — set SANDBAR_TOKEN env OR run 'sandbar rotate-token corpus <key>'" >&2
      exit 1
    fi
    body='{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"sandbar.aggregate.count","arguments":{"class":":mm/Memory"}}}'
    cnt=$(curl -s -X POST "http://localhost:$SANDBAR_PORT/mcp" \
          -H "Authorization: Bearer $token" \
          -H "Content-Type: application/json" \
          -d "$body" 2>/dev/null | grep -oE 'count[\\"]+ *: *[0-9]+' | head -1 | grep -oE '[0-9]+' || echo 0)
    if [ "${cnt:-0}" = "0" ]; then
      corpus_root="${SANDBAR_CORPUS_ROOT:-$HOME/claude}"
      echo "DB is empty — auto-importing ${corpus_root}/memory/ ..."
      import_body=$(cat <<EOF
{"jsonrpc":"2.0","id":2,"method":"tools/call","params":{"name":"sandbar.project.import","arguments":{"from":"${corpus_root}","filter":{"tree-filter":"memory/"},"persist?":true}}}
EOF
)
      result=$(curl -s -X POST "http://localhost:$SANDBAR_PORT/mcp" \
               --max-time 600 \
               -H "Authorization: Bearer $token" \
               -H "Content-Type: application/json" \
               -d "$import_body" 2>/dev/null)
      imported=$(echo "$result" | grep -oE 'imported[\\"]+ *: *[0-9]+' | head -1 | grep -oE '[0-9]+' || echo 0)
      groups=$(echo "$result" | grep -oE 'groups[\\"]+ *: *[0-9]+' | head -1 | grep -oE '[0-9]+' || echo 0)
      failed=$(echo "$result" | grep -oE 'failed-count[\\"]+ *: *[0-9]+' | head -1 | grep -oE '[0-9]+' || echo 0)
      echo "auto-import complete: $imported entities across $groups memorials ($failed failed)"
    else
      echo "DB has $cnt :mm/Memory entities — skipping auto-import"
    fi
    ;;

  reproject-bootstrap)
    # Stage 3 of plans/sandbar_bootstrap_authority_arc_2026_05_21.md.
    # Renders sandbar's substrate state to corpus markdown memorials.
    # SAFE-DEFAULT: writes to a scratch dir (no canonical overwrite).
    # Pass --canonical to write to client-project memory/.
    # Pass --dry-run to report without writing.
    #
    # CAVEAT per interaction/bootstrap_rendering_must_preserve_narrative_human_readable_content_2026_05_21.md
    # — current render output is INTROSPECTION-ONLY (no narrative);
    # --canonical is BLOCKED until Stage 2.D narrative templates land.
    shift
    cd "$SANDBAR_HOME"
    lein reproject-bootstrap "$@"
    ;;

  log)
    tail -f "$SANDBAR_LOG_FILE"
    ;;

  backup)
    # Forward to lein backup-db; pass through args (optional label).
    # Shells out to bin/datomic backup-db (admin JVM); live-system safe.
    # Per memory/libraries/datomic/backup_restore.md §12 + Dan-directive
    # c-then-a 2026-05-23.
    shift
    cd "$SANDBAR_HOME"
    exec lein backup-db "$@"
    ;;

  restore)
    # Backup-dir REQUIRED.  Preflight verify-backup + :dev-transactor-up
    # checks run inside the script.
    shift
    cd "$SANDBAR_HOME"
    exec lein restore-db-from "$@"
    ;;

  verify-backup)
    # Defaults to LATEST backup if no arg.
    shift
    cd "$SANDBAR_HOME"
    exec lein verify-backup "$@"
    ;;

  backup-list)
    cd "$SANDBAR_HOME"
    exec lein list-backups
    ;;

  backup-prune)
    # --keep-days N [--keep-count K] [--confirm]
    shift
    cd "$SANDBAR_HOME"
    exec lein prune-backups "$@"
    ;;

  verify-restore)
    # Verify the restore path end-to-end via isolated second transactor.
    # Doesn't touch the live transactor — operationally safe to run anytime.
    # Per memory/observations/gate_2_restore_path_verified_end_to_end_lifts_no_reset_db_2026_05_24.md
    shift
    cd "$SANDBAR_HOME"
    exec lein verify-restore "$@"
    ;;

  config-show|config)
    # Print the resolved 3-layer config (+ provenance with --provenance).
    # Per ADR sandbar_deployment_consumption_cohabitability_strategy_2026_05_24 D.G
    shift || true
    cd "$SANDBAR_HOME"
    exec lein config-show "$@"
    ;;

  list-dbs)
    # Enumerate Datomic databases on the configured transactor.
    # Reveals ALL consumers' DBs under the F2 shared-transactor cohabitability model.
    # Per ADR sandbar_deployment_consumption_cohabitability_strategy_2026_05_24 D.G
    cd "$SANDBAR_HOME"
    exec lein list-dbs
    ;;

  maintenance-import)
    # The quiescent maintenance import (D7, 2026-09-20): runs
    # sandbar.scripts.maintenance-import in an admin JVM against the
    # configured store with the server STOPPED — no MCP caller, reactive
    # worker or scheduler can write.  Refuses while the server runs.
    # Point --from at the selected staging root for repairs, or at the
    # mapped canonical memory/ directory for new-document enrollment.
    # --persist --stamp binds the newly imported identity into its pinned
    # canonical file. A staging copy cannot receive that stamp. A root
    # mixing memory/ with other Markdown directories is refused.
    # Dry run without --persist.  Receipts default to
    # .sandbar/receipts/maintenance-import-<ts>/.  Exit 0 only when every
    # step finished whole.  Procedure: doc/operations.md § Maintenance import.
    shift
    pid=$(running_pid || true)
    if [ -n "$pid" ]; then
      echo "sandbar is running (PID $pid) — stop it first ('sandbar stop'); the maintenance import runs only on a quiescent store" >&2
      exit 1
    fi
    case " $* " in
      *" --receipts "*) ;;
      *) set -- "$@" --receipts "${SANDBAR_CONFIG}/receipts/maintenance-import-$(date +%Y%m%d-%H%M%S)" ;;
    esac
    cd "$SANDBAR_HOME"
    exec lein maintenance-import -- --port "$SANDBAR_PORT" "$@"
    ;;

  drift-audit)
    # The stopped-server drift audit (D7b/D8, 2026-09-20): runs
    # sandbar.scripts.drift-audit in an admin JVM against the configured
    # store with the server STOPPED, so a maintenance import's result is
    # audited before any restart.  --from defaults to the client dir;
    # --out <file.json> writes the full report.  Over the wire, while the
    # server runs, the same audit is sandbar_audit_fs-substrate-drift.
    shift
    pid=$(running_pid || true)
    if [ -n "$pid" ]; then
      echo "sandbar is running (PID $pid) — stop it first ('sandbar stop'); the stopped-server audit reads a quiescent store (use sandbar_audit_fs-substrate-drift over the wire while it runs)" >&2
      exit 1
    fi
    case " $* " in
      *" --from "*) ;;
      *) set -- "$@" --from "$SANDBAR_CLIENT_DIR" ;;
    esac
    cd "$SANDBAR_HOME"
    exec lein drift-audit -- "$@"
    ;;

  *)
    cat >&2 <<EOF
Usage: sandbar <command>

Commands:
  start                          — start sandbar (idempotent); auto-init if DB empty + token present
  stop                           — stop sandbar (idempotent)
  restart                        — stop + start
  init                           — fresh-DB auto-import (idempotent; requires running + token)
  export <dir> --project <ident> --destination <name> [--execute --expect-plan <token>] [--provenance]
                                 — guarded project export (W1.H first build).  Default is a
                                   PREVIEW: plans on one basis, writes a private audit, prints
                                   counts + the plan-token, writes no staging output.
                                   --execute re-plans and writes only with the preview's
                                   token; <dir> must be an absolute FRESH child of the named
                                   destination's staging root (created by the server, never
                                   by this wrapper); files land at <dir>/<rel-path>.  Success
                                   is status complete + complete? true; anything else exits
                                   non-zero.  Requires bb to decode the response.
  verify-export <dir> [--expect-manifest <sha256>]
                                 — read-only exact file-set/hash check against the completed
                                   export manifest; no database/config/token/git access.
                                   Requires bb; does not establish restore eligibility.
  recovery-check <dir> --project <ident> --destination <name> [--expect-manifest <sha256>]
                                 — read-only export-origin and snapshot comparison using
                                   the configured private audit; never approves import.
                                   Exit 0: same store/basis; 3: review required; 1/2: failure.
  reproject-bootstrap [opts]     — Re-render bootstrap memorials (types/ + predicates/) from
                                   substrate state.  Default: scratch dir.  Opts: --dry-run,
                                   --canonical (BLOCKED until templates land), --class :mm/X.
  status                         — show running state + token + memory-count
  rotate-token <service> <key>   — issue a fresh MCP token + persist
  log                            — tail the server log
  backup [<label>]               — incremental Datomic backup-db to .sandbar/backups/
                                   <sid>-<TS>[-<label>]-datomic1.0.7482/; writes status.edn
                                   sidecar.  Live-system safe.  Admin-JVM out-of-band.
  restore <backup-dir> [<name>]  — restore-db from a backup dir.  Preflights verify-backup +
                                   :dev-transactor-up.  Target DB name defaults to source
                                   (per Datomic restore-db invariant).
  verify-backup [<backup-dir>]   — verify-backup over latest (or named) backup;
                                   updates status.edn with :verified-at + :verify-exit-code.
  backup-list                    — list backups + status (newest first).
  backup-prune [opts]            — prune by age/count.  Opts: --keep-days N, --keep-count K,
                                   --confirm (DRY RUN without --confirm).
  verify-restore [<backup-dir>]  — restore-path end-to-end verification via isolated 2nd
                                   transactor; compares cardinality to live-as-of-t.
                                   Per Gate 2 ADR; safe (doesn't touch live transactor).
  config-show [--provenance]     — print the resolved 3-layer config; --provenance shows
                                   per-layer contributions (bundled defaults + client
                                   <SANDBAR_CLIENT_DIR>/.sandbar/config.edn + env vars).
  list-dbs                       — enumerate Datomic databases on the configured transactor;
                                   reveals all consumers' DBs (F2 cohabitability model).
  maintenance-import [opts]      — quiescent import into the live store with the server STOPPED
                                   (refuses otherwise).  --from <import-root> [--persist] [--stamp]
                                   [--exclude-file f] [--retract-file f] [--receipts dir]
                                   [--mode replace|additive].  Dry run without --persist.
                                   --stamp enrolls new files from their canonical memory/ root.
                                   Receipts default to .sandbar/receipts/maintenance-import-<ts>/.
                                   Exit 0 only when every step finished whole; 1 when a report
                                   is incomplete or the server is running; 3 when the JVM
                                   preflight refused (mixed root).  doc/operations.md.
  drift-audit [--from dir] [--out f] — the stopped-server drift audit (refuses while running):
                                   audit the store in-process after a maintenance import,
                                   before restarting; --out writes the full JSON report.

Config (env):
  SANDBAR_HOME=$SANDBAR_HOME
  SANDBAR_PORT=$SANDBAR_PORT
  SANDBAR_CLIENT_DIR=$SANDBAR_CLIENT_DIR
  SANDBAR_TOKEN_FILE=$SANDBAR_TOKEN_FILE

Per decisions/sandbar_token_lives_in_client_project_not_user_global_2026_05_21.md:
tokens live in the CLIENT PROJECT (.sandbar/token under the corpus root),
not in a user-global ~/.config/sandbar/ location.  Gitignored.
EOF
    exit 2
    ;;
esac
