;; sandbar/config/config-example.edn — the COMMITTED example of the
;; Tier-1 bundled-defaults config (config/config.edn, which is
;; GITIGNORED and therefore absent on a fresh checkout).
;;
;; TWO roles:
;;   1. Example — copy to config/config.edn and edit :db for your
;;      deployment.
;;   2. Fresh-checkout FALLBACK — when config.edn is absent from the
;;      classpath, `sandbar.config/read-bundled-defaults` serves THIS
;;      file (with a loud stderr notice) so `:required-schema` resolves
;;      and a fresh checkout's test/acceptance run works out of the box
;;      instead of silently loading no schema.  Keep `:required-schema`
;;      here in lockstep with config.edn — `sandbar.config-test/
;;      example-required-schema-matches-primary` guards the drift.
{:db      {:url "datomic:dev://localhost:4334/"
           :sid "example"}

 ;; Sandbar HTTP port. Override per installation when the port is occupied.
 :port 8389

 ;; Operator-owned persistence destinations, keyed by an EXISTING Project's
 ;; stable :mm.project/ident. Each absolute directory owns its memory/ subtree.
 ;; Unmapped projects retain SANDBAR_CORPUS_ROOT. Keep roots nonoverlapping.
 ;; Example after enrollment: {:project/clj-figlet "/absolute/path/to/clj-figlet"}
 ;; Changing this map requires stopped-writer maintenance and file reconciliation;
 ;; it neither migrates existing files nor authorizes public export.
 :project-roots {}

 ;; Guarded export destinations are separate from canonical persistence roots.
 ;; The stable project key must already be enrolled in :project-roots. Existing
 ;; absolute staging/audit roots must be outside every source tree; audit roots
 ;; must be private (0700) and outside every staging root. No default destination.
 ;; Example (create/review the directories during operator setup):
 ;; {"figlet-public" {:project :project/clj-figlet :audience :public
 ;;                   :staging-root "/absolute/private/export-staging"
 ;;                   :audit-root "/absolute/private/export-audit"}}
 :export-destinations {}

 ;; Schema files loaded at startup, in order.  Each maps to
 ;; schema/<name>.edn under the project resources.  Order matters —
 ;; later schemas may reference idents declared by earlier ones.
 ;;
 ;; :meta      - dt/* metamodel primitives (Class, Property, Resource, ...)
 ;; :ref       - dt/Ref reference type
 ;; :literal   - scalar / primitive types (dt/Literal subclasses)
 ;; :fn        - Datomic function entities
 ;; :any       - polymorphic variant type
 ;; :context   - context-ident attributes
 ;; :event     - event-bus primitive types
 ;; :user      - user accounts + sessions
 ;; :twit      - example domain (Twitter user model)
 ;; :auth      - bearer-token auth schema
 ;; :audit     - audit-log primitive types
 ;; :workflow         - state-machine workflow primitives (meta-schema)
 ;; :job              - background-job tracking
 ;; :mm               - memory-model substrate (mm/Memory, mm/Section, etc.)
 ;; :workflow-session - :workflow/session lifecycle definition;
 ;;                     loads AFTER :workflow + :mm-meta — depends on
 ;;                     :workflow/State + :workflow/Transition + :mm/Workflow
 ;;                     classes from :workflow, and :mm.memory/* slots from :mm
 ;;                     family.
 :required-schema [:meta :ref :literal :fn :any :context :event :user :twit :auth :audit :workflow :job :mm :mm-artifact :mm-signal :mm-guidance :mm-meta :mm-verb :mm-temporal :mm-namespace :workflow-session]
 ;; :workflow {:stale-session-window-ms 43200000}
 ;;   — inactivity window (ms) for the crashed-session staleness rule of
 ;;     sandbar.util.workflow/close-leaked-sessions!. Absent ⇒
 ;;     the code default of twelve hours.

 ;; Scheduler configuration. The bundled defaults enable the scheduler and
 ;; its two operational system jobs. Override these for a disposable service
 ;; that should not run scheduled work.
 ;;
 ;; :enabled?     — when true, sandbar.core/start invokes
 ;;                 sandbar.schedule/enable! + start! (handler-pool +
 ;;                 fire-thread + :mm.event/Scheduled subscriber).
 ;; :system-jobs? — when true, boot seeds + schedules 2 system jobs
 ;;                 (idempotent :db/ident upsert; dtstart anchored at boot):
 ;;                   db-stats              FREQ=MINUTELY;INTERVAL=15 → substrate counts
 ;;                   reactive-queue-health FREQ=MINUTELY;INTERVAL=10 → queue health
 ;;                 Both emit :db-only operational telemetry (→
 ;;                 :event/SystemEvent, NOT corpus :mm/EventLog).
 ;; :jobs         — enumeration slot for additional Schedule idents to
 ;;                 autostart at boot (future use).
 ;;
 ;; Opt out by flipping :enabled? and/or :system-jobs? to false.
 :scheduler {:enabled?     true
             :system-jobs? true
             :jobs         []}

 ;; Future-timestamp guard.
 ;; dt/make and dt/update-entity! — hence entity.create / entity.update and
 ;; the markdown codec create path — refuse a :mm.memory/created or
 ;; :mm.memory/last-touched value more than this many SECONDS ahead of
 ;; server time (absent values default to server time on create).  Absent
 ;; or non-numeric ⇒ 60.  Per-call override: sandbar.db.datatype/
 ;; *future-timestamp-skew-ms*.
 :future-timestamp-skew-seconds 60

 :nrepl   {:port 28888}
 :auth {:twitter
        {:consumer-key    ""
         :consumer-secret ""
         :access-token    ""
         :access-secret   ""}}}
