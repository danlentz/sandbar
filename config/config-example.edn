{:db      {:url "datomic:dev://localhost:4334/"
           :sid "example"}

 ;; Schema files loaded at startup, in order.  Each maps to
 ;; schema/<name>.edn under the project resources.  Order matters —
 ;; later schemas may reference idents declared by earlier ones.
 ;;
 ;; :meta      - dt/* metamodel primitives (Class, Property, Resource, ...)
 ;; :ref       - dt/Ref reference type
 ;; :literal   - scalar / primitive types (dt/Literal subclasses)
 ;; :fn        - Datomic function entities
 ;; :any       - polymorphic variant type
 ;; :context   - context-ident attributes
 ;; :event     - event-bus primitive types
 ;; :user      - user accounts + sessions
 ;; :twit      - example domain (Twitter user model)
 ;; :auth      - bearer-token auth schema
 ;; :audit     - audit-log primitive types
 ;; :workflow         - state-machine workflow primitives (meta-schema)
 ;; :job              - background-job tracking
 ;; :mm               - memory-model substrate (mm/Memory, mm/Section, etc.)
 ;; :workflow-session - :workflow/session lifecycle definition (ι.2 substrate;
 ;;                     loads AFTER :workflow + :mm-meta — depends on
 ;;                     :workflow/State + :workflow/Transition + :mm/Workflow
 ;;                     classes from :workflow, and :mm.memory/* slots from :mm
 ;;                     family.  Per ι.2 substrate execution 2026-05-25.)
 :required-schema [:meta :ref :literal :fn :any :context :event :user :twit :auth :audit :workflow :job :mm :workflow-session]

 :nrepl   {:port 28888}
 :auth {:twitter
        {:consumer-key    ""
         :consumer-secret ""
         :access-token    ""
         :access-secret   ""}}}
