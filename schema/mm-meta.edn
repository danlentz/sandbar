[
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; :mm/Meta — Abstract Supertype for Schema / Structural / Workflow-State Memorials
;;
;; Per:
;;   - memory/types/meta.md (corpus self-description)
;;   - decisions/sandbar_memorial_type_substrate_layering_2026_05_21.md (D2)
;;   - decisions/sandbar_memorial_type_ontology_corrections_round_c_2026_05_21.md (R1 + R5)
;;
;; NAMING: :mm/Meta preserved (R1).  :mm/MetaType is a SUB-ABSTRACT under :mm/Meta.
;;
;; DIRECT CONCRETE SUBTYPES:
;;   :mm/Type, :mm/Predicate, :mm/Inbox, :mm/Task, :mm/Event, :mm/Engine,
;;   :mm/Organization, :mm/Context (amend; existing forward decl), :mm/Rule (amend; existing forward decl).
;;
;; SUB-ABSTRACTS:
;;   :mm/Actor (existing forward decl; ELEVATE to :dt/abstract? true)
;;     concretes: :mm/AIActor, :mm/HumanActor, :mm/SystemActor
;;     NOTE: existing schema/mm.edn lines 1412+ declares flat :mm.actor/* slot namespace
;;     covering all actor subtypes (model-family / version / capabilities / role /
;;     runs-in-context / belongs-to / etc.).  This file does NOT redeclare those slots
;;     — sub-subtypes inherit them via :dt/subclass-of :mm/Actor.
;;   :mm/MetaType (new sub-abstract for MOP-style metaclass lift)
;;     concretes: :mm/MarkdownMetaType, :mm/CodeMetaType, future :mm/DatabaseMetaType
;;
;; INHERITANCE: :mm/Meta :dt/subclass-of :mm/Memory.  ABSTRACT.
;;
;; NOTE — existing :mm.actor/* + :mm.context/* + :mm.rule/* slots in schema/mm.edn
;; are NOT redeclared here (Datomic rejects :db.error/unsupported-alter-schema).
;; Slot expansion (e.g., :mm.rule/event-ref, :mm.context/firewall-class) is a
;; deliberate follow-up sub-arc with proper migration discipline.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

 ;; Forward Declarations (new classes only — Actor/Context/Rule already in mm.edn forward decls)
 [{:db/ident :mm/Type         :db/doc "Forward declaration; full definition later."}
  {:db/ident :mm/Predicate    :db/doc "Forward declaration; full definition later."}
  {:db/ident :mm/Inbox        :db/doc "Forward declaration; full definition later."}
  {:db/ident :mm/Task         :db/doc "Forward declaration; full definition later."}
  {:db/ident :mm/Event        :db/doc "Forward declaration; full definition later."}
  {:db/ident :mm/Engine       :db/doc "Forward declaration; full definition later."}
  {:db/ident :mm/Organization :db/doc "Forward declaration; full definition later."}
  {:db/ident :mm/AIActor      :db/doc "Forward declaration; sub-subtype of :mm/Actor; full definition later."}
  {:db/ident :mm/HumanActor   :db/doc "Forward declaration; sub-subtype of :mm/Actor; full definition later."}
  {:db/ident :mm/SystemActor  :db/doc "Forward declaration; sub-subtype of :mm/Actor; full definition later."}
  {:db/ident :mm/MetaType         :db/doc "Forward declaration (sub-abstract); full definition later."}
  {:db/ident :mm/MarkdownMetaType :db/doc "Forward declaration; sub-subtype of :mm/MetaType; full definition later."}
  {:db/ident :mm/CodeMetaType     :db/doc "Forward declaration; sub-subtype of :mm/MetaType; full definition later."}]

 [{:db/ident         :mm/Meta
   :dt/type          :dt/Class
   :dt/subclass-of   :mm/Memory
   :dt/context       "mm"
   :dt/label         "Meta"
   :dt/abstract?     true
   :db/doc "Abstract supertype for memorial types describing the memory system itself — schema-facing memorials.  Per memory/types/meta.md.  Direct concrete subtypes: :mm/Type, :mm/Predicate, :mm/Inbox, :mm/Task, :mm/Event, :mm/Engine, :mm/Organization, :mm/Context, :mm/Rule.  Sub-abstracts: :mm/Actor + :mm/MetaType.  Category-level invariants: schema-facing (validation rules apply differently than to artifacts); :mm/Meta memorials don't carry :supersedes.  Per decisions/sandbar_memorial_type_substrate_layering_2026_05_21.md D2 + corrections R1/R5.  Not instantiated directly."}]

