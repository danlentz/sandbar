;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Class Definitions — Meta sub-tree
;;
;; Actor / Context / Rule are AMENDED: idempotent upsert of :db/ident adds
;; :dt/subclass-of :mm/Meta + (for Actor) :dt/abstract? true.  No :dt/slots
;; redeclared (mm.edn's existing :mm.actor/* / :mm.context/* / :mm.rule/* slots
;; cover the per-class field set).
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

 [{:db/ident         :mm/Actor
   :dt/type          :dt/Class
   :dt/subclass-of   :mm/Meta
   :dt/context       "mm"
   :dt/label         "Actor"
   :dt/abstract?     true
   :db/doc "Abstract supertype for entities that take actions in the memory system — AI models, human collaborators, automated processes.  AMENDED (2026-05-21): :dt/abstract? true; sub-abstract under :mm/Meta.  Concrete subtypes: :mm/AIActor, :mm/HumanActor, :mm/SystemActor.  Per memory/types/actor.md.  Existing :mm.actor/* slots in schema/mm.edn cover the flat per-subtype field set (model-family / version / capabilities / role / runs-in-context / belongs-to / etc.)."}

  {:db/ident         :mm/MetaType
   :dt/type          :dt/Class
   :dt/subclass-of   :mm/Meta
   :dt/context       "mm"
   :dt/label         "MetaType"
   :dt/abstract?     true
   :db/doc "Abstract supertype for substrate / access-protocol classifications — MOP-style metaclass lift.  Concrete subtypes: :mm/MarkdownMetaType, :mm/CodeMetaType, future :mm/DatabaseMetaType.  Per memory/types/meta_type.md.  Not instantiated directly."}

  {:db/ident         :mm/Type
   :dt/type          :dt/Class
   :dt/subclass-of   :mm/Meta
   :dt/context       "mm"
   :dt/label         "Type"
   :dt/native-codec  :markdown
   :dt/slots         [:mm.type/tier
                      :mm.type/mid-conversation-captureable
                      :mm.type/inject-trigger
                      :mm.type/inject-class-name
                      :mm.type/inject-action
                      :mm.type/audit-class
                      :mm.type/subtree
                      :mm.type/subtree-aliases
                      :mm.type/introduced-in]
   :dt/abstract?     false
   :db/doc "Self-referential type-of-types — describes what entries of some other type should contain.  Per memory/types/type.md.  Carries captureability metadata family + tier classification + corpus subtree routing + introduced-in."}

  {:db/ident         :mm/Predicate
   :dt/type          :dt/Class
   :dt/subclass-of   :mm/Meta
   :dt/context       "mm"
   :dt/label         "Predicate"
   :dt/native-codec  :markdown
   :dt/slots         [:mm.predicate/characteristics
                      :mm.predicate/inverse-of
                      :mm.predicate/same-type?
                      :mm.predicate/acyclic?
                      :mm.predicate/lifecycle-status
                      :mm.predicate/deprecated-in
                      :mm.predicate/retired-in
                      :mm.predicate/migration-to
                      :mm.predicate/migration-from
                      :mm.predicate/prefer-over
                      :mm.predicate/reach-for-instead]
   :dt/abstract?     false
   :db/doc "First-class typed-edge predicate — RDFS-native property-as-memory.  Per memory/types/predicate.md.  Domain + range carried via :dt/domain + :dt/range (substrate-shared).  Introduced-in: 0.4.0."}

  {:db/ident         :mm/Inbox
   :dt/type          :dt/Class
   :dt/subclass-of   :mm/Meta
   :dt/context       "mm"
   :dt/label         "Inbox"
   :dt/native-codec  :markdown
   :dt/slots         [:mm.inbox/suggested-type
                      :mm.inbox/importance]
   :dt/abstract?     false
   :db/doc "Low-ceremony staging note — sub-60-second capture via `mem notice`.  Promoted during `/memory-review` OR deleted.  Per memory/types/inbox.md.  Zettelkasten 'fleeting note' (Ahrens 2017); 70-80% discard rate is a feature.  Audit-exempt from reciprocal / body-link audits."}

  {:db/ident         :mm/Task
   :dt/type          :dt/Class
   :dt/subclass-of   :mm/Meta
   :dt/context       "mm"
   :dt/label         "Task"
   :dt/native-codec  :markdown
   :dt/slots         [:mm.task/status
                      :mm.task/priority
                      :mm.task/effort
                      :mm.task/triggered-by
                      :mm.task/blockers]
   :dt/abstract?     false
   :db/doc "Durable actionable work item.  Distinct from :mm/Inbox (observation-shaped) and :mm/Plan (multi-stage arc).  Per memory/types/task.md.  Captureable: inject-trigger 'come back to this', 'blocked on X'."}

  {:db/ident         :mm/Event
   :dt/type          :dt/Class
   :dt/subclass-of   :mm/Meta
   :dt/context       "mm"
   :dt/label         "Event"
   :dt/native-codec  :markdown
   :dt/slots         [:mm.event/lifecycle-position
                      :mm.event/default-severity
                      :mm.event/applicable-actor-classes
                      :mm.event/triggered-by-hook
                      :mm.event/substrate-correctness-criticality]
   :dt/abstract?     false
   :db/doc "First-class lifecycle / dispatch event — typed-edge graph citizen that hooks fire and rules trigger from.  Per memory/types/event.md.  Introduced-in: 0.8.0."}

  {:db/ident         :mm/Engine
   :dt/type          :dt/Class
   :dt/subclass-of   :mm/Meta
   :dt/context       "mm"
   :dt/label         "Engine"
   :dt/native-codec  :markdown
   :dt/slots         [:mm.engine/rule-body-shape
                      :mm.engine/dispatch-strategy-default
                      :mm.engine/complexity-tier
                      :mm.engine/performance-characteristics
                      :mm.engine/library-implementation
                      :mm.engine/applicable-rule-body-classes]
   :dt/abstract?     false
   :db/doc "First-class rule-body evaluation engine.  Per memory/types/engine.md.  Five canonical engines: :plain-pattern, :malli, :clara-rules, :core-logic, :meander-strategy.  Introduced-in: 0.8.0."}

  {:db/ident         :mm/Organization
   :dt/type          :dt/Class
   :dt/subclass-of   :mm/Meta
   :dt/context       "mm"
   :dt/label         "Organization"
   :dt/native-codec  :markdown
   :dt/slots         [:mm.organization/org-class
                      :mm.organization/members
                      :mm.organization/founded
                      :mm.organization/url]
   :dt/abstract?     false
   :db/doc "Grouping of actors.  Peer-of-:mm/Actor (NOT subtype) — orgs are SUBJECTS of pronouncements but don't perform corpus-actions.  Per memory/types/organization.md.  Introduced-in: 0.8.0."}

  {:db/ident         :mm/Context
   :dt/type          :dt/Class
   :dt/subclass-of   :mm/Meta
   :dt/context       "mm"
   :dt/label         "Context"
