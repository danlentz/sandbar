;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Metamodel
;;
;; An RDFS-inspired type system layered on top of Datomic. While Datomic
;; provides a powerful schema for attributes (valueType, cardinality, etc.),
;; it does not natively support the notion of "classes" or typed instances.
;; This metamodel fills that gap.
;;
;; Core Concepts:
;;
;;   Resource  - The root of all things (like rdfs:Resource)
;;   Class     - A type definition that can have instances (like rdfs:Class)
;;   Property  - An attribute with domain and range (like rdf:Property)
;;   List      - An ordered collection via cons cells (like rdf:List)
;;
;; Key Properties:
;;
;;   :dt/type        - Links an instance to its class (like rdf:type)
;;   :dt/subclass-of - Defines class inheritance (like rdfs:subClassOf)
;;   :dt/domain      - Restricts which classes may have a property
;;   :dt/range       - Specifies the type of a property's values
;;   :dt/slots       - Declares which properties belong to a class
;;
;; Integration with Datomic:
;;
;; The metamodel complements rather than replaces Datomic's schema. Each
;; :dt/Property is also a Datomic attribute with :db/valueType and
;; :db/cardinality. Native Datomic attributes like :db/doc and :db/ident
;; are incorporated as properties with appropriate domain/range constraints.
;;
;; This layering enables:
;;   - Class-based typing via :dt/type
;;   - Inheritance hierarchies via :dt/subclass-of
;;   - Slot inheritance (classes inherit parent slots)
;;   - Validation against class definitions
;;   - Introspection of the type system itself
;;
;; The schema is bootstrapped carefully: forward declarations establish
;; idents, then properties are defined, then classes reference those
;; properties. Some entities are defined twice - first as placeholders,
;; then augmented with full metadata.
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;


[
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Forward Declarations
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

 [{:db/ident :dt/Resource
   :db/doc   "A thing"}

  {:db/ident :dt/Property
   :db/doc   "An attribute of a thing"}

  {:db/ident :dt/Class
   :db/doc   "A general type of thing"}

  {:db/ident :dt/List
   :db/doc   "An ad-hoc ordered collection"}

  {:db/ident       :dt/type
   :db/valueType   :db.type/ref
   :db/cardinality :db.cardinality/one
   :db/doc "A reference to the classes of a Resource"}]

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Early Property Attributes
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

 [{:db/ident :dt/domain
   :dt/type  :dt/Property
   :db/valueType :db.type/ref
   :db/cardinality :db.cardinality/one
   :db/doc "The datatype that may have a given property"}

  {:db/ident       :dt/range
   :dt/type        :dt/Property
   :db/valueType   :db.type/ref
   :db/cardinality :db.cardinality/one
   :db/doc "The datatype of a property's value"}]

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Early Attributes Fixup
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

 [{:db/ident  :dt/range
   :dt/domain :dt/Class
   :dt/range  :dt/Class}

  {:db/ident  :dt/domain
   :dt/domain :dt/Class
   :dt/range  :dt/Class}

  {:db/ident  :dt/type
   :dt/type   :dt/Property
   :dt/domain :dt/Resource
   :dt/range  :dt/Class}]

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Native Properties
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

 [{:db/ident  :db/cardinality
   :dt/type   :dt/Property
   :dt/domain :dt/Property
   :dt/range  :db.type/ref}  ;; TODO: first class cardinality types

  {:db/ident  :db/unique
   :dt/type   :dt/Property
   :dt/domain :dt/Property
   :dt/range  :db.type/ref}  ;; TODO: (as above)

  {:db/ident  :db/fulltext
   :dt/type   :dt/Property
   :dt/domain :dt/Property
   :dt/range  :db.type/boolean}

  {:db/ident  :db/doc
   :dt/type   :dt/Property
   :dt/domain :dt/Resource
   :dt/range  :db.type/string}

  {:db/ident  :db/valueType
   :dt/type   :dt/Property
   :dt/domain :dt/Property
   :dt/range  :dt/Class}

  {:db/ident  :db/ident
   :dt/type   :dt/Property
   :dt/domain :dt/Resource
   :dt/range  :db.type/keyword}]

  ;; NOTE: "boot datoms" cannot be altered (?)

  ;; {:db/ident  :db/valueType
  ;;  :dt/type   :dt/Property
  ;;  :dt/domain :dt/Property
  ;;  :dt/range  :db.type/ref}

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Fundamental Properties
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

 [{:db/ident :dt/context ;; TODO: -> dt/context; first class context
   :dt/type  :dt/Property
   :dt/domain :dt/Resource
   :dt/range :db.type/string
   :db/valueType :db.type/string
   :db/cardinality :db.cardinality/one
   :db/doc "Resources have qualified names. This designates the namespace."}

  {:db/ident :dt/label
   :dt/type  :dt/Property
   :dt/domain :dt/Resource
   :dt/range :db.type/string
   :db/valueType :db.type/string
   :db/cardinality :db.cardinality/one
   :db/doc "The local part or unqualified name of a Resource"}

  {:db/ident :dt/subclass-of
   :dt/type  :dt/Property
   :dt/domain :dt/Class
   :dt/range :dt/Class
   :db/valueType :db.type/ref
   :db/cardinality :db.cardinality/many
   :db/doc "The data type(s) this data type inherits from."}

  {:db/ident :dt/first
   :dt/type  :dt/Property
   :dt/domain :dt/List
   :dt/range :dt/Resource
   :db/valueType :db.type/ref
   :db/cardinality :db.cardinality/one
   :db/doc "First item in List"}

  {:db/ident :dt/rest
   :dt/type  :dt/Property
   :dt/domain :dt/List
   :dt/range :dt/List
   :db/valueType :db.type/ref
   :db/cardinality :db.cardinality/one
   :db/doc "Remaining items in List"}

  ;; MAYBE: still deciding how to handle aggregates

  {:db/ident :dt/list
   :dt/type  :dt/Property
   :dt/domain :dt/Class
   :dt/range :dt/Class
   :db/valueType :db.type/ref
   :db/cardinality :db.cardinality/one
   :db/doc "Dynamically generated reference to a list data type.
           Provides support for multi-dimensional values."}

  {:db/ident :dt/items
   :dt/type  :dt/Property
   :dt/domain :dt/Class
   :dt/range :dt/Resource
   :db/valueType :db.type/ref
   :db/cardinality :db.cardinality/many
   :db/doc "References item membership in list."}

  {:db/ident :dt/component
   :dt/type  :dt/Property
   :dt/domain :dt/Class
   :dt/range :dt/Class
   :db/valueType :db.type/ref
   :db/cardinality :db.cardinality/one
   :db/doc "Only populated for list data types."}

  {:db/ident :dt/slots
   :dt/type  :dt/Property
   :db/valueType :db.type/ref
   :dt/domain :dt/Class
   :dt/range :dt/Property
   :db/cardinality :db.cardinality/many
   :db/doc "References to the data type fields, themselves data types."}

  {:db/ident :dt/subproperty-of
   :dt/type  :dt/Property
   :dt/domain :dt/Property
   :dt/range :dt/Property
   :db/valueType :db.type/ref
   :db/cardinality :db.cardinality/many
   :db/doc "Defines parent attributes."}

  {:db/ident :dt/abstract?
   :dt/type  :dt/Property
   :dt/domain :dt/Class
   :dt/range :db.type/boolean
   :db/valueType :db.type/boolean
   :db/cardinality :db.cardinality/one
   :db/doc "Abstract classes should not be directly instantiated."}

  {:db/ident :dt/required?
   :dt/type  :dt/Property
   :dt/domain :dt/Property
   :dt/range :db.type/boolean
   :db/valueType :db.type/boolean
   :db/cardinality :db.cardinality/one
   :db/doc "If true, instances must provide a value for this slot."}

  {:db/ident :dt/validator
   :dt/type  :dt/Property
   :dt/domain :dt/Class
   :dt/range :db.type/symbol
   :db/valueType :db.type/symbol
   :db/cardinality :db.cardinality/one
   :db/doc "Fully-qualified symbol of a custom validator function (fn [entity] -> nil | error-map)."}

  {:db/ident :dt/native-codec
   :dt/type  :dt/Property
   :dt/domain :dt/Class
   :dt/range :db.type/keyword
   :db/valueType :db.type/keyword
   :db/cardinality :db.cardinality/one
   :db/doc "Per-class default codec format hint. The codec mediator
            (sandbar.codec) uses this when no explicit :format hint is
            provided. E.g., :mm/Memory → :markdown. Per
            decisions/sandbar_codec_layer_owns_wire_format_concerns_consumer_native_representation_2026_05_12.md §2.5."}]

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Fundamental Classes
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

 [{:db/ident :dt/Resource
   :dt/type  :dt/Class
   :dt/context "meta"
   :dt/label "Resource"
   :db/doc "Resource is the abstract superclass of all classes"
   :dt/slots [:db/doc :db/ident :dt/context :dt/label :dt/type]}

  {:db/ident :dt/Class
   :dt/type :dt/Class
   :dt/context "meta"
   :dt/subclass-of :dt/Resource
   :dt/label "Class"
   :dt/slots [:dt/subclass-of :dt/abstract? :dt/list :dt/component :dt/slots :dt/validator :dt/native-codec]}

  {:db/ident :dt/Property
   :dt/type :dt/Class
   :dt/subclass-of :dt/Resource
   :dt/label "Property"
   :dt/context "meta"
   :dt/slots [:db/cardinality :db/unique :db/fulltext
              :dt/domain :dt/range :dt/subproperty-of :dt/required?]}

  {:db/ident :dt/List
   :dt/type :dt/Class
   :dt/subclass-of :dt/Resource
   :dt/label "List"
   :dt/context "meta"
   :dt/slots [:dt/first :dt/rest]}]

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; nil maybe, maybe not
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

 [{:db/ident :Nil
   :dt/type  :dt/List
   :dt/label "Nil"
   :dt/context "meta"}]

