;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Property-characteristic intersection classes — SWCLOS-style metaclass
;; pattern (per ADR sandbar_rdfs_entailment_via_datomic_native_datalog_rules_
;; with_swclos_style_metaclass_property_characteristics_2026_05_21 + synthesis
;; §4 + implementation arc Stage 4).
;;
;; Property characteristics (TransitiveProperty / AsymmetricProperty / ...)
;; compose orthogonally on a single property — e.g., :mm.memory/descends-from
;; is simultaneously transitive AND asymmetric AND irreflexive.  Sandbar's
;; `:dt/type` is cardinality-one (preserved by ADR D2), so orthogonal
;; characteristics are modeled via INTERSECTION CLASSES that multi-
;; `:dt/subclass-of` the component characteristic classes.  The property
;; declares ONE `:dt/type` (the intersection class); RDFS rule rdfs9
;; (subClassOf instance lift) entails membership in each component class.
;;
;; The 6 intersection classes declared below correspond exactly to the
;; characteristic combinations actually used in the corpus predicate
;; vocabulary (61 predicate memorials surveyed; output of
;; etc/audit_characteristics.bb in the corpus repo):
;;
;;   :dt/DirectedBinaryRelationProperty       — 41 predicates ([asymmetric, irreflexive])
;;   :dt/StrictPartialOrderProperty           — 8 predicates  ([asymmetric, irreflexive, transitive])
;;   :dt/AntisymmetricStrictOrderProperty     — 6 predicates  ([antisymmetric, irreflexive, transitive])
;;   :dt/AsymmetricFunctionalIrreflexiveProperty — 3 predicates ([asymmetric, functional, irreflexive])
;;   :dt/IrreflexiveSymmetricProperty         — 2 predicates  ([irreflexive, symmetric])
;;   :dt/FunctionalIrreflexiveProperty        — 1 predicate   ([functional, irreflexive])
;;
;; Hand-named for canonical math/OWL terms (StrictPartialOrder,
;; DirectedBinaryRelation); compositional naming for the long-tail.
;;
;; `:dt/subclass-of` is cardinality-many so a vector value is accepted
;; (and produces a multi-subclass-of relationship; rdfs11 transitivity
;; derives `:dt/subclass-of :dt/Property` via the marker classes' chains).
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

 [{:db/ident :dt/DirectedBinaryRelationProperty
   :dt/type :dt/Class
   :dt/subclass-of [:dt/AsymmetricProperty :dt/IrreflexiveProperty]
   :dt/context "meta"
   :dt/slots []
   :dt/label "Directed Binary Relation Property"
   :db/doc "Intersection class — a property that is asymmetric AND irreflexive (the default 'directed binary relation' shape used by ~41 predicates in the corpus vocabulary).  Activates OWL 2 RL rules prp-asyp (asymmetric integrity check) + prp-irp (irreflexive integrity check) via rdfs9 entailment.  Cardinality-one preserved on `:dt/type` of the consuming property; the orthogonal characteristics are derived via the `:dt/subclass-of` chain per the SWCLOS-style metaclass pattern."}

  {:db/ident :dt/StrictPartialOrderProperty
   :dt/type :dt/Class
   :dt/subclass-of [:dt/AsymmetricProperty :dt/IrreflexiveProperty :dt/TransitiveProperty]
   :dt/context "meta"
   :dt/slots []
   :dt/label "Strict Partial Order Property"
   :db/doc "Intersection class — a property that is asymmetric AND irreflexive AND transitive; the canonical mathematical 'strict partial order' shape (e.g., descends-from, supersedes, requires lineage chains).  Activates OWL 2 RL rules prp-asyp + prp-irp + prp-trp via rdfs9 entailment."}

  {:db/ident :dt/AntisymmetricStrictOrderProperty
   :dt/type :dt/Class
   :dt/subclass-of [:dt/AntisymmetricProperty :dt/IrreflexiveProperty :dt/TransitiveProperty]
   :dt/context "meta"
   :dt/slots []
   :dt/label "Antisymmetric Strict Order Property"
   :db/doc "Intersection class — antisymmetric (weaker than asymmetric) AND irreflexive AND transitive; used by the corpus for mereology predicates (has-part / part-of) and refinement / specialization hierarchies (extends, refines, specializes, generalizes).  The antisymmetric characteristic allows the OWL DL formulation `x R y ∧ y R x → x = y` rather than the strict `x R y → ¬(y R x)`; in practice with the irreflexive constraint also present, the relation is asymmetric per `:dt/AntisymmetricProperty`'s docstring on the compile-to-OWL-2-RL note (treat antisymmetric + irreflexive as if asymmetric for prp-asyp)."}

  {:db/ident :dt/AsymmetricFunctionalIrreflexiveProperty
   :dt/type :dt/Class
   :dt/subclass-of [:dt/AsymmetricProperty :dt/FunctionalProperty :dt/IrreflexiveProperty]
   :dt/context "meta"
   :dt/slots []
   :dt/label "Asymmetric Functional Irreflexive Property"
   :db/doc "Intersection class — asymmetric AND functional AND irreflexive; used by the corpus for unique-endpoint relations (created-with, has-beginning, has-end) where each subject has at most one value, the value relation doesn't loop back, and self-reference is forbidden.  Activates prp-asyp + prp-fp + prp-irp via rdfs9 entailment."}

  {:db/ident :dt/IrreflexiveSymmetricProperty
   :dt/type :dt/Class
   :dt/subclass-of [:dt/IrreflexiveProperty :dt/SymmetricProperty]
   :dt/context "meta"
   :dt/slots []
   :dt/label "Irreflexive Symmetric Property"
   :db/doc "Intersection class — irreflexive AND symmetric; used by the corpus for bidirectional non-loop relations (composes-with, related).  Activates prp-irp (irreflexive integrity) + prp-symp (symmetric derivation) via rdfs9 entailment."}

  {:db/ident :dt/FunctionalIrreflexiveProperty
   :dt/type :dt/Class
   :dt/subclass-of [:dt/FunctionalProperty :dt/IrreflexiveProperty]
   :dt/context "meta"
   :dt/slots []
   :dt/label "Functional Irreflexive Property"
   :db/doc "Intersection class — functional AND irreflexive; used by the corpus for single-valued non-self-loop relations (instance-of).  Activates prp-fp (functional sameAs derivation) + prp-irp (irreflexive integrity) via rdfs9 entailment."}

  {:db/ident :dt/EquivalenceRelationProperty
   :dt/type :dt/Class
   :dt/subclass-of [:dt/TransitiveProperty :dt/SymmetricProperty :dt/ReflexiveProperty]
   :dt/context "meta"
   :dt/slots []
   :dt/label "Equivalence Relation Property"
   :db/doc "Intersection class — transitive AND symmetric AND reflexive; the canonical mathematical 'equivalence relation' shape (the 3 OWL 2 RL characteristics that together define equivalence per OWL 2 semantics).  Used by symmetric Allen interval relations (notably `:mm.interval/equals` per Phase D Temporal Tier-2 — an interval is equal-to itself reflexively, equal-to-X iff X equal-to it symmetrically, and equality is transitive across intervals).  Activates OWL 2 RL rules prp-trp (transitive derivation) + prp-symp (symmetric derivation) + prp-rflp (reflexive derivation) via rdfs9 entailment.  Composes with `:dt/inverse-of` to model self-inverse symmetric relations without requiring an explicit inverse-pair declaration."}]

