;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Property-Characteristic Marker Classes (OWL 2 RL aligned)
;;
;; Each marker class is a sub-class of :dt/Property.  A predicate slot declares
;; its property-characteristics by adding `:dt/type :dt/<MarkerClass>` to its
;; slot definition (cardinality-many `:dt/type` permits multiple markers per
;; property — e.g. an asymmetric+irreflexive predicate).
;;
;; Names align with OWL 2 RL `prp-*` rule families per
;; resources/w3c_owl2_rl_in_rif_2012.md — entailment rules at the substrate
;; layer (Layer 0 per plans/layered_rule_subsystem_architecture_arc_2026_05_21.md)
;; can compile from these marker-class assertions to native Datomic Datalog
;; rules.
;;
;; Per interaction/check_substrate_schema_attribute_names_against_rdf_owl_semantics_2026_05_13.md
;; the names follow OWL 2 canonical terminology exactly.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

 [{:db/ident :dt/TransitiveProperty
   :dt/type :dt/Class
   :dt/subclass-of :dt/Property
   :dt/context "meta"
   :dt/slots []
   :dt/label "TransitiveProperty"
   :db/doc "OWL 2 owl:TransitiveProperty alignment.  A property whose value chain is transitive: (?p type TransitiveProperty) ∧ (x p y) ∧ (y p z) → (x p z).  Compiles to OWL 2 RL rule prp-trp."}

  {:db/ident :dt/SymmetricProperty
   :dt/type :dt/Class
   :dt/subclass-of :dt/Property
   :dt/context "meta"
   :dt/slots []
   :dt/label "Symmetric Property"
   :db/doc "OWL 2 owl:SymmetricProperty alignment.  A property whose value is bidirectional: (?p type SymmetricProperty) ∧ (x p y) → (y p x).  Compiles to OWL 2 RL rule prp-symp."}

  {:db/ident :dt/AsymmetricProperty
   :dt/type :dt/Class
   :dt/subclass-of :dt/Property
   :dt/context "meta"
   :dt/slots []
   :dt/label "Asymmetric Property"
   :db/doc "OWL 2 owl:AsymmetricProperty alignment.  A property whose extension is asymmetric: (?p type AsymmetricProperty) ∧ (x p y) → ¬(y p x).  Compiles to OWL 2 RL rule prp-asyp (consistency check; firing implies inconsistency).  Logically: asymmetric ≡ antisymmetric + irreflexive — see :dt/AntisymmetricProperty for the weaker variant the corpus uses for mereology (has-part / part-of)."}

  {:db/ident :dt/AntisymmetricProperty
   :dt/type :dt/Class
   :dt/subclass-of :dt/Property
   :dt/context "meta"
   :dt/slots []
   :dt/label "Antisymmetric Property"
   :db/doc "Antisymmetric property characteristic — used by the corpus for proper-mereology predicates (has-part / part-of).  Antisymmetric ≡ ∀x∀y. (x R y ∧ y R x → x = y); weaker than asymmetric (which is antisymmetric + irreflexive).  NOT an OWL 2 standard characteristic (OWL has only owl:AsymmetricProperty); declared here because the corpus's predicate memorials distinguish — has-part / part-of use `antisymmetric` (allowing in principle x = y self-relations, though irreflexive is also declared making the practical effect equivalent to asymmetric).  When compiling to OWL 2 RL rules, treat antisymmetric + irreflexive declarations as if asymmetric (both compile to prp-asyp consistency check)."}

  {:db/ident :dt/ReflexiveProperty
   :dt/type :dt/Class
   :dt/subclass-of :dt/Property
   :dt/context "meta"
   :dt/slots []
   :dt/label "Reflexive Property"
   :db/doc "OWL 2 owl:ReflexiveProperty alignment.  A property where every entity in the domain relates to itself: (?p type ReflexiveProperty) ∧ (x p _) → (x p x).  Compiles to OWL 2 RL rule prp-rflp."}

  {:db/ident :dt/IrreflexiveProperty
   :dt/type :dt/Class
   :dt/subclass-of :dt/Property
   :dt/context "meta"
   :dt/slots []
   :dt/label "Irreflexive Property"
   :db/doc "OWL 2 owl:IrreflexiveProperty alignment.  A property where no entity relates to itself: (?p type IrreflexiveProperty) ∧ (x p x) → inconsistent.  Compiles to OWL 2 RL rule prp-irp."}

  {:db/ident :dt/FunctionalProperty
   :dt/type :dt/Class
   :dt/subclass-of :dt/Property
   :dt/context "meta"
   :dt/slots []
   :dt/label "Functional Property"
   :db/doc "OWL 2 owl:FunctionalProperty alignment.  A property where each subject has at most one value: (?p type FunctionalProperty) ∧ (x p y1) ∧ (x p y2) → sameAs(y1, y2).  Compiles to OWL 2 RL rule prp-fp."}

  {:db/ident :dt/InverseFunctionalProperty
   :dt/type :dt/Class
   :dt/subclass-of :dt/Property
   :dt/context "meta"
   :dt/slots []
   :dt/label "Inverse-Functional Property"
   :db/doc "OWL 2 owl:InverseFunctionalProperty alignment.  A property where each object has at most one subject: (?p type InverseFunctionalProperty) ∧ (x1 p y) ∧ (x2 p y) → sameAs(x1, x2).  Compiles to OWL 2 RL rule prp-ifp."}

