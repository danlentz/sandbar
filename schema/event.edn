[
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Event Model
;;
;; A general-purpose event ontology combining schema.org Event concepts with
;; server-specific event tracking. Events represent things that happen at a
;; point in time, optionally with duration, involving actors and targets.
;;
;; Class Hierarchy:
;;
;;                      dt/Event [abstract]
;;                          |
;;          ________________|________________
;;         |                |                |
;;   event/ServerEvent  event/UserEvent  event/SystemEvent
;;         |
;;     ____|____________________
;;    |           |             |
;; event/     event/        event/
;; HttpRequest  ApiCall     Transaction
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Forward Declarations
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

 [{:db/ident :dt/Event
   :db/doc "Abstract base class for all events"}

  {:db/ident :event/ServerEvent
   :db/doc "Events generated by server-side processing"}

  {:db/ident :event/HttpRequest
   :db/doc "An HTTP request/response cycle"}

  {:db/ident :event/ApiCall
   :db/doc "An API endpoint invocation"}

  {:db/ident :event/Transaction
   :db/doc "A Datomic transaction event"}]

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Event Properties
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

 [{:db/ident :event/timestamp
   :dt/type :dt/Property
   :dt/domain :dt/Event
   :dt/range :db.type/instant
   :db/valueType :db.type/instant
   :db/cardinality :db.cardinality/one
   :db/doc "When the event occurred"}

  {:db/ident :event/name
   :dt/type :dt/Property
   :dt/domain :dt/Event
   :dt/range :db.type/string
   :db/valueType :db.type/string
   :db/cardinality :db.cardinality/one
   :db/doc "Human-readable name or title of the event"}

  {:db/ident :event/description
   :dt/type :dt/Property
   :dt/domain :dt/Event
   :dt/range :db.type/string
   :db/valueType :db.type/string
   :db/cardinality :db.cardinality/one
   :db/doc "Detailed description of what happened"}

  {:db/ident :event/kind
   :dt/type :dt/Property
   :dt/domain :dt/Event
   :dt/range :db.type/keyword
   :db/valueType :db.type/keyword
   :db/cardinality :db.cardinality/one
   :db/doc "Event type/kind as a keyword (e.g., :http/request, :db/transaction)"}

  {:db/ident :event/actor
   :dt/type :dt/Property
   :dt/domain :dt/Event
   :dt/range :dt/Ref
   :db/valueType :db.type/ref
   :db/cardinality :db.cardinality/one
   :db/doc "The agent/entity that triggered or performed this event"}

  {:db/ident :event/target
   :dt/type :dt/Property
   :dt/domain :dt/Event
   :dt/range :dt/Ref
   :db/valueType :db.type/ref
   :db/cardinality :db.cardinality/one
   :db/doc "The entity this event affects or references"}

  {:db/ident :event/duration
   :dt/type :dt/Property
   :dt/domain :dt/Event
   :dt/range :db.type/long
   :db/valueType :db.type/long
   :db/cardinality :db.cardinality/one
   :db/doc "Duration of the event in milliseconds"}

  {:db/ident :event/status
   :dt/type :dt/Property
   :dt/domain :dt/Event
   :dt/range :db.type/keyword
   :db/valueType :db.type/keyword
   :db/cardinality :db.cardinality/one
   :db/doc "Outcome status (e.g., :success, :failure, :pending)"}

  {:db/ident :event/tags
   :dt/type :dt/Property
   :dt/domain :dt/Event
   :dt/range :db.type/keyword
   :db/valueType :db.type/keyword
   :db/cardinality :db.cardinality/many
   :db/doc "Tags/labels for categorization and filtering"}

  {:db/ident :event/correlation-id
   :dt/type :dt/Property
   :dt/domain :dt/Event
   :dt/range :db.type/uuid
   :db/valueType :db.type/uuid
   :db/cardinality :db.cardinality/one
   :db/doc "UUID for correlating related events across a request/workflow"}

  {:db/ident :event/parent
   :dt/type :dt/Property
   :dt/domain :dt/Event
   :dt/range :dt/Event
   :db/valueType :db.type/ref
   :db/cardinality :db.cardinality/one
   :db/doc "Parent event for hierarchical event tracking (spans)"}]

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Server Event Properties
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

 [{:db/ident :event/level
   :dt/type :dt/Property
   :dt/domain :event/ServerEvent
   :dt/range :db.type/keyword
   :db/valueType :db.type/keyword
   :db/cardinality :db.cardinality/one
   :db/doc "Severity level (:trace, :debug, :info, :warn, :error, :fatal)"}

  {:db/ident :event/namespace
   :dt/type :dt/Property
   :dt/domain :event/ServerEvent
   :dt/range :db.type/string
   :db/valueType :db.type/string
   :db/cardinality :db.cardinality/one
   :db/doc "Source namespace or component that generated the event"}

  {:db/ident :event/thread
   :dt/type :dt/Property
   :dt/domain :event/ServerEvent
   :dt/range :db.type/string
   :db/valueType :db.type/string
   :db/cardinality :db.cardinality/one
   :db/doc "Thread name where event occurred"}

  {:db/ident :event/exception
   :dt/type :dt/Property
   :dt/domain :event/ServerEvent
   :dt/range :db.type/string
   :db/valueType :db.type/string
   :db/cardinality :db.cardinality/one
   :db/doc "Exception message if event represents an error"}

  {:db/ident :event/stacktrace
   :dt/type :dt/Property
   :dt/domain :event/ServerEvent
   :dt/range :db.type/string
   :db/valueType :db.type/string
   :db/cardinality :db.cardinality/one
   :db/doc "Stack trace for error events"}]

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; HTTP Request Properties
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

 [{:db/ident :http/method
   :dt/type :dt/Property
   :dt/domain :event/HttpRequest
   :dt/range :db.type/keyword
   :db/valueType :db.type/keyword
   :db/cardinality :db.cardinality/one
   :db/doc "HTTP method (:get, :post, :put, :delete, etc.)"}

  {:db/ident :http/path
   :dt/type :dt/Property
   :dt/domain :event/HttpRequest
   :dt/range :db.type/string
   :db/valueType :db.type/string
   :db/cardinality :db.cardinality/one
   :db/doc "Request URI path"}

  {:db/ident :http/query-string
   :dt/type :dt/Property
   :dt/domain :event/HttpRequest
   :dt/range :db.type/string
   :db/valueType :db.type/string
   :db/cardinality :db.cardinality/one
   :db/doc "Query string parameters"}

  {:db/ident :http/status-code
   :dt/type :dt/Property
   :dt/domain :event/HttpRequest
   :dt/range :db.type/long
   :db/valueType :db.type/long
   :db/cardinality :db.cardinality/one
   :db/doc "HTTP response status code"}

  {:db/ident :http/content-type
   :dt/type :dt/Property
   :dt/domain :event/HttpRequest
   :dt/range :db.type/string
   :db/valueType :db.type/string
   :db/cardinality :db.cardinality/one
   :db/doc "Request/response content type"}

  {:db/ident :http/remote-addr
   :dt/type :dt/Property
   :dt/domain :event/HttpRequest
   :dt/range :db.type/string
   :db/valueType :db.type/string
   :db/cardinality :db.cardinality/one
   :db/doc "Client IP address"}

  {:db/ident :http/user-agent
   :dt/type :dt/Property
   :dt/domain :event/HttpRequest
   :dt/range :db.type/string
   :db/valueType :db.type/string
   :db/cardinality :db.cardinality/one
   :db/doc "Client user agent string"}

  {:db/ident :http/request-size
   :dt/type :dt/Property
   :dt/domain :event/HttpRequest
   :dt/range :db.type/long
   :db/valueType :db.type/long
   :db/cardinality :db.cardinality/one
   :db/doc "Request body size in bytes"}

  {:db/ident :http/response-size
   :dt/type :dt/Property
   :dt/domain :event/HttpRequest
   :dt/range :db.type/long
   :db/valueType :db.type/long
   :db/cardinality :db.cardinality/one
   :db/doc "Response body size in bytes"}]

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; API Call Properties
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

 [{:db/ident :api/endpoint
   :dt/type :dt/Property
   :dt/domain :event/ApiCall
   :dt/range :db.type/keyword
   :db/valueType :db.type/keyword
   :db/cardinality :db.cardinality/one
   :db/doc "API endpoint identifier"}

  {:db/ident :api/handler
   :dt/type :dt/Property
   :dt/domain :event/ApiCall
   :dt/range :db.type/symbol
   :db/valueType :db.type/symbol
   :db/cardinality :db.cardinality/one
   :db/doc "Handler function that processed the request"}

  {:db/ident :api/params
   :dt/type :dt/Property
   :dt/domain :event/ApiCall
   :dt/range :db.type/string
   :db/valueType :db.type/string
   :db/cardinality :db.cardinality/one
   :db/doc "Request parameters (as EDN string)"}]

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Transaction Properties
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

 [{:db/ident :tx/id
   :dt/type :dt/Property
   :dt/domain :event/Transaction
   :dt/range :db.type/long
   :db/valueType :db.type/long
   :db/cardinality :db.cardinality/one
   :db/doc "Datomic transaction ID"}

  {:db/ident :tx/datom-count
   :dt/type :dt/Property
   :dt/domain :event/Transaction
   :dt/range :db.type/long
   :db/valueType :db.type/long
   :db/cardinality :db.cardinality/one
   :db/doc "Number of datoms in the transaction"}

  {:db/ident :tx/entities-affected
   :dt/type :dt/Property
   :dt/domain :event/Transaction
   :dt/range :db.type/long
   :db/valueType :db.type/long
   :db/cardinality :db.cardinality/one
   :db/doc "Number of entities modified"}]

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Event Classes
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

 [{:db/ident :dt/Event
   :dt/type :dt/Class
   :dt/subclass-of :dt/Ref
   :dt/context "event"
   :dt/label "Event"
   :dt/abstract? true
   :db/doc "Abstract base class for all events. An event is something that happens at a point in time."
   :dt/slots [:event/timestamp
              :event/name
              :event/description
              :event/kind
              :event/actor
              :event/target
              :event/duration
              :event/status
              :event/tags
              :event/correlation-id
              :event/parent]}]

 [{:db/ident :event/ServerEvent
   :dt/type :dt/Class
   :dt/subclass-of :dt/Event
   :dt/context "event"
   :dt/label "Server Event"
   :db/doc "Events generated by server-side processing, including logs and metrics"
   :dt/slots [:event/level
              :event/namespace
              :event/thread
              :event/exception
              :event/stacktrace]}

  {:db/ident :event/UserEvent
   :dt/type :dt/Class
   :dt/subclass-of :dt/Event
   :dt/context "event"
   :dt/label "User Event"
   :db/doc "Events triggered by user actions (login, logout, profile update, etc.)"}

  {:db/ident :event/SystemEvent
   :dt/type :dt/Class
   :dt/subclass-of :dt/Event
   :dt/context "event"
   :dt/label "System Event"
   :db/doc "Events from system lifecycle (startup, shutdown, health checks, scheduled tasks)"}]

 [{:db/ident :event/HttpRequest
   :dt/type :dt/Class
   :dt/subclass-of :event/ServerEvent
   :dt/context "event"
   :dt/label "HTTP Request"
   :db/doc "An HTTP request/response cycle"
   :dt/slots [:http/method
              :http/path
              :http/query-string
              :http/status-code
              :http/content-type
              :http/remote-addr
              :http/user-agent
              :http/request-size
              :http/response-size]}

  {:db/ident :event/ApiCall
   :dt/type :dt/Class
   :dt/subclass-of :event/ServerEvent
   :dt/context "event"
   :dt/label "API Call"
   :db/doc "An API endpoint invocation with handler details"
   :dt/slots [:api/endpoint
              :api/handler
              :api/params]}

  {:db/ident :event/Transaction
   :dt/type :dt/Class
   :dt/subclass-of :event/ServerEvent
   :dt/context "event"
   :dt/label "Transaction"
   :db/doc "A Datomic transaction event"
   :dt/slots [:tx/id
              :tx/datom-count
              :tx/entities-affected]}]

]
