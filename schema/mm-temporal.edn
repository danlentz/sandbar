;; :mm.interval/* — Allen's 13 typed-edge interval relations
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; 12 directional relations carry :dt/type :dt/StrictPartialOrderProperty
;; (asymmetric + irreflexive + transitive; Wave 1 intersection class; activates
;; prp-asyp + prp-irp + prp-trp via rdfs9 entailment).
;;
;; 1 symmetric relation (`:mm.interval/equals`) carries :dt/type
;; :dt/EquivalenceRelationProperty (transitive + symmetric + reflexive;
;; NEW intersection class added to meta.edn in this β.1.B commit; activates
;; prp-trp + prp-symp + prp-rflp).
;;
;; Cardinality-many per Q.D.5 (an interval can be :before multiple other
;; intervals; aligns with SKOS broaderMatch ↔ narrowerMatch precedent).
;;
;; Per Q.D.10 — β.1.B ships ONLY composition with existing prp-inv1 /
;; prp-inv2 / prp-trp / prp-symp / prp-rflp rules.  Full Allen
;; path-consistency / interval-algebra composition is DEFERRED to a future arc.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

 [;; 12 directional Allen relations (StrictPartialOrderProperty: asymmetric + irreflexive + transitive)
  {:db/ident       :mm.interval/before
   :dt/type        :dt/StrictPartialOrderProperty
   :dt/domain      :mm/Interval
   :dt/range       :mm/Interval
   :db/valueType   :db.type/ref
   :db/cardinality :db.cardinality/many
   :db/doc "Allen's :before — interval A entirely precedes interval B (end(A) < start(B); no overlap).  OWL-Time `time:intervalBefore` analog.  Inverse-of :mm.interval/after (explicit `:dt/inverse-of` declared separately).  Transitive (A before B + B before C → A before C via prp-trp).  Asymmetric + irreflexive."}

  {:db/ident       :mm.interval/after
   :dt/type        :dt/StrictPartialOrderProperty
   :dt/domain      :mm/Interval
   :dt/range       :mm/Interval
   :db/valueType   :db.type/ref
   :db/cardinality :db.cardinality/many
   :db/doc "Allen's :after — interval A entirely follows interval B (start(A) > end(B); no overlap).  OWL-Time `time:intervalAfter` analog.  Inverse-of :mm.interval/before (derived via prp-inv1)."}

  {:db/ident       :mm.interval/meets
   :dt/type        :dt/StrictPartialOrderProperty
   :dt/domain      :mm/Interval
   :dt/range       :mm/Interval
   :db/valueType   :db.type/ref
   :db/cardinality :db.cardinality/many
   :db/doc "Allen's :meets — end(A) coincides with start(B) (touching but not overlapping).  OWL-Time `time:intervalMeets` analog.  Inverse-of :mm.interval/met-by."}

  {:db/ident       :mm.interval/met-by
   :dt/type        :dt/StrictPartialOrderProperty
   :dt/domain      :mm/Interval
   :dt/range       :mm/Interval
   :db/valueType   :db.type/ref
   :db/cardinality :db.cardinality/many
   :db/doc "Allen's :met-by — start(A) coincides with end(B).  OWL-Time `time:intervalMetBy` analog.  Inverse-of :mm.interval/meets."}

  {:db/ident       :mm.interval/overlaps
   :dt/type        :dt/StrictPartialOrderProperty
   :dt/domain      :mm/Interval
   :dt/range       :mm/Interval
   :db/valueType   :db.type/ref
   :db/cardinality :db.cardinality/many
   :db/doc "Allen's :overlaps — A starts before B starts AND A ends during B (partial overlap with A's end inside B).  OWL-Time `time:intervalOverlaps` analog.  Inverse-of :mm.interval/overlapped-by."}

  {:db/ident       :mm.interval/overlapped-by
   :dt/type        :dt/StrictPartialOrderProperty
   :dt/domain      :mm/Interval
   :dt/range       :mm/Interval
   :db/valueType   :db.type/ref
   :db/cardinality :db.cardinality/many
   :db/doc "Allen's :overlapped-by — A starts during B AND A ends after B ends.  OWL-Time `time:intervalOverlappedBy` analog.  Inverse-of :mm.interval/overlaps."}

  {:db/ident       :mm.interval/during
   :dt/type        :dt/StrictPartialOrderProperty
   :dt/domain      :mm/Interval
   :dt/range       :mm/Interval
   :db/valueType   :db.type/ref
   :db/cardinality :db.cardinality/many
   :db/doc "Allen's :during — A is strictly contained within B (start(B) < start(A) AND end(A) < end(B); no boundary coincidence).  OWL-Time `time:intervalDuring` analog.  Inverse-of :mm.interval/contains.  NOTE: distinct from the proposed :mm.activity/during slot that was REJECTED in Q.D.8 (the cross-axis Activity → Interval slot is :mm.activity/spans-interval instead, to avoid name collision with this Allen relation)."}

  {:db/ident       :mm.interval/contains
   :dt/type        :dt/StrictPartialOrderProperty
   :dt/domain      :mm/Interval
   :dt/range       :mm/Interval
   :db/valueType   :db.type/ref
   :db/cardinality :db.cardinality/many
   :db/doc "Allen's :contains — A strictly contains B (start(A) < start(B) AND end(B) < end(A)).  OWL-Time `time:intervalContains` analog.  Inverse-of :mm.interval/during."}

  {:db/ident       :mm.interval/starts
   :dt/type        :dt/StrictPartialOrderProperty
   :dt/domain      :mm/Interval
   :dt/range       :mm/Interval
   :db/valueType   :db.type/ref
   :db/cardinality :db.cardinality/many
   :db/doc "Allen's :starts — A shares a starting point with B AND A ends before B (start(A) = start(B) AND end(A) < end(B)).  OWL-Time `time:intervalStarts` analog.  Inverse-of :mm.interval/started-by."}

  {:db/ident       :mm.interval/started-by
   :dt/type        :dt/StrictPartialOrderProperty
   :dt/domain      :mm/Interval
   :dt/range       :mm/Interval
   :db/valueType   :db.type/ref
   :db/cardinality :db.cardinality/many
   :db/doc "Allen's :started-by — A shares a starting point with B AND A ends after B (start(A) = start(B) AND end(B) < end(A)).  OWL-Time `time:intervalStartedBy` analog.  Inverse-of :mm.interval/starts."}

  {:db/ident       :mm.interval/finishes
   :dt/type        :dt/StrictPartialOrderProperty
   :dt/domain      :mm/Interval
   :dt/range       :mm/Interval
   :db/valueType   :db.type/ref
   :db/cardinality :db.cardinality/many
   :db/doc "Allen's :finishes — A shares an ending point with B AND A starts after B (end(A) = end(B) AND start(B) < start(A)).  OWL-Time `time:intervalFinishes` analog.  Inverse-of :mm.interval/finished-by."}

  {:db/ident       :mm.interval/finished-by
   :dt/type        :dt/StrictPartialOrderProperty
   :dt/domain      :mm/Interval
   :dt/range       :mm/Interval
   :db/valueType   :db.type/ref
   :db/cardinality :db.cardinality/many
   :db/doc "Allen's :finished-by — A shares an ending point with B AND A starts before B (end(A) = end(B) AND start(A) < start(B)).  OWL-Time `time:intervalFinishedBy` analog.  Inverse-of :mm.interval/finishes."}

  ;; 1 symmetric Allen relation (EquivalenceRelationProperty: transitive + symmetric + reflexive)
  {:db/ident       :mm.interval/equals
   :dt/type        :dt/EquivalenceRelationProperty
   :dt/domain      :mm/Interval
   :dt/range       :mm/Interval
   :db/valueType   :db.type/ref
   :db/cardinality :db.cardinality/many
   :db/doc "Allen's :equals — A and B coincide exactly (start(A) = start(B) AND end(A) = end(B)).  OWL-Time `time:intervalEquals` analog.  Symmetric (A equals B ↔ B equals A; self-inverse — no separate `:dt/inverse-of` declaration needed because the :dt/EquivalenceRelationProperty intersection-class activates prp-symp for symmetric derivation).  Transitive + reflexive also."}]


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; 6 explicit :dt/inverse-of declarations for Allen's directional pairs
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Separate tx batch per SKOS broaderMatch ↔ narrowerMatch precedent
;; (mm.edn relations block).  prp-inv1 + prp-inv2 entailment rules derive
;; the reverse direction automatically once these explicit declarations land.
;;
;; :mm.interval/equals is NOT in this batch — its symmetric characteristic
;; (via :dt/EquivalenceRelationProperty) makes it self-inverse; prp-symp
;; derives the reverse without needing an explicit inverse-of declaration.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

 [{:db/ident :mm.interval/before     :dt/inverse-of :mm.interval/after}
