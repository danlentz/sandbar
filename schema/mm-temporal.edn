;; slots: :mm.activity/{agent, ended-at, generated, started-at, status, used,
;; was-informed-by}.  NEW additions below.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

 [{:db/ident       :mm.run/job
   :dt/type        :dt/Property
   :dt/domain      :mm/Run
   :dt/range       :mm/Job
   :db/valueType   :db.type/ref
   :db/cardinality :db.cardinality/one
   :db/doc "Reference to the :mm/Job spec this Run is an instance of.  Per Phase 2 ADR D.3.  Semantic refinement of :mm.activity/spec when the Activity is specifically a Run executing a Job."}

  {:db/ident       :mm.run/status
   :dt/type        :dt/Property
   :dt/domain      :mm/Run
   :dt/range       :db.type/ref
   :db/valueType   :db.type/ref
   :db/cardinality :db.cardinality/one
   :db/doc "Schema.org actionStatus 4-state for the Run lifecycle.  Values: :run.status/potential, :run.status/active, :run.status/completed, :run.status/failed.  Per Phase 2 ADR D.5.  Distinct from inherited :mm.activity/status (which is the bare PROV-O activity status); :mm.run/status carries the Schema.org-aligned 4-state machine."}

  {:db/ident       :mm.run/phenomenon-time
   :dt/type        :dt/Property
   :dt/domain      :mm/Run
   :dt/range       :db.type/instant
   :db/valueType   :db.type/instant
   :db/cardinality :db.cardinality/one
   :db/doc "SOSA bitemporal phenomenonTime — when the OBSERVED PHENOMENON occurred (e.g., when a sensor reading was sampled), distinct from :mm.activity/started-at (resultTime — when the Activity began executing).  Per Phase 2 ADR D.3 + SOSA-SSN bitemporal distinction memorial."}

  {:db/ident       :mm.run/result
   :dt/type        :dt/Property
   :dt/domain      :mm/Run
   :dt/range       :db.type/ref
   :db/valueType   :db.type/ref
   :db/cardinality :db.cardinality/one
   :db/doc "Reference to the produced output entity when Run reaches :run.status/completed.  Per Phase 2 ADR D.3.  Distinct from existing :mm.run/output which is the raw return value; :mm.run/result is the semantically-meaningful produced :dt/Resource."}

  {:db/ident       :mm.run/error
   :dt/type        :dt/Property
   :dt/domain      :mm/Run
   :dt/range       :db.type/string
   :db/valueType   :db.type/string
   :db/cardinality :db.cardinality/one
   :db/doc "Error message / ex-info edn string when Run reaches :run.status/failed.  Companion to :mm.run/result for the failure branch of the 4-state machine."}]


