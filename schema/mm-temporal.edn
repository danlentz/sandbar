  {:db/ident :mm.interval/overlaps   :dt/inverse-of :mm.interval/overlapped-by}
  {:db/ident :mm.interval/during     :dt/inverse-of :mm.interval/contains}
  {:db/ident :mm.interval/starts     :dt/inverse-of :mm.interval/started-by}
  {:db/ident :mm.interval/finishes   :dt/inverse-of :mm.interval/finished-by}]


