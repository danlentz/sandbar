;; :mm.activity/* — NEW slots added to :mm/Activity (cross-root edges)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

 [{:db/ident       :mm.activity/spec
   :dt/type        :dt/Property
   :dt/domain      :mm/Activity
   :dt/range       :mm/Spec
   :db/valueType   :db.type/ref
   :db/cardinality :db.cardinality/one
   :db/doc "Reference to the :mm/Spec this Activity executes — PROV-O prov:hadPlan analog.  Cross-root typed edge: Activity → Spec.  For :mm/Run → :mm/Job; for :mm/Process → :mm/Workflow; pure prov:Plan semantics."}

  {:db/ident       :mm.activity/event-kind
   :dt/type        :dt/Property
   :dt/domain      :mm/Activity
   :dt/range       :db.type/keyword
   :db/valueType   :db.type/keyword
   :db/cardinality :db.cardinality/one
   :db/doc "BPMN flow-node event-kind discriminator for Activities that participate in workflow control-flow as events.  Values: :event-kind/start | :event-kind/intermediate | :event-kind/end | :event-kind/signal | :event-kind/timer | :event-kind/message.  Per Phase 2 ADR D.7 — BPMN's 'event' (flow-node sense) is an :mm/Activity sub-shape, NOT a :mm/Event subtype (which is the LODE outside-observed sense)."}]


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; :mm.run/* — NEW slots added to :mm/Run (status + bitemporal + result/error)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Existing slots on :mm/Run (NOT re-declared): :mm.run/attempt-number,
