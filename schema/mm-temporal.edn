;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; 2 :mm/Shape XOR Shape entities — enforce Option ε paired-property XOR
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Consumes β.1.A's :mm.shape/XorConstraint substrate (sandbar commit 2424259).
;; Each shape applies-to :mm/Interval and declares ONE XorConstraint sub-entity
;; pairing the ObjectProperty form (`-instant`) with the DatatypeProperty
;; form (`-time`) — :mm.shape.xor/slot-a + :mm.shape.xor/slot-b are EITHER/OR;
;; exactly one of the pair must be populated per :mm/Interval instance.
;;
;; Per Q.D.6 — severity :violation (XOR is a semantic invariant; entity.create
;; / entity.update boundary rejects in :strict mode; :audit mode logs).
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

 [;; The 2 :mm.shape/XorConstraint sub-entities.  Each carries BOTH a tempid
  ;; AND a stable :db/ident.  The tempid is required because
  ;; :mm.shape/xor-constraints is :db.type/ref WITHOUT :db/isComponent, so the
  ;; owning shape must reference the sub-entity by explicit :db/id within the
  ;; same tx (a Datomic constraint).  The :db/ident is LOAD-BEARING: because
  ;; initialize-db! retransacts schema on every boot, a tempid-only sub-entity
  ;; would resolve to a NEW eid each reload + APPEND to the cardinality-many
  ;; slot — the sub-entities would proliferate (~40/shape observed) and each
  ;; seed shape's slot would accumulate duplicate refs, never retracting.  The
  ;; :db/ident makes the tempid unify (upsert) with the prior boot's eid, so
  ;; reload is idempotent — the same discipline that keeps the two :mm/Shape
  ;; entities below at count 2.  RULE: ANY schema-seeded constraint sub-entity
  ;; (Xor / Cardinality / Pattern / Datatype) MUST carry a stable :db/ident for
  ;; this reason.  See sandbar.db.datomic/prune-duplicate-seed-constraint-
  ;; subentities! (self-heals DBs that accumulated pre-ident duplicates) +
  ;; observations/schema_seeded_ref_subentities_without_db_ident_proliferate_on_reload.
  {:db/id #db/id[:db.part/user -101]
   :db/ident :memory.shapes.xor/interval-begins-at
   :dt/type :mm.shape/XorConstraint
   :mm.shape.xor/slot-a :mm.interval/begins-at-instant
   :mm.shape.xor/slot-b :mm.interval/begins-at-time}

  {:db/id #db/id[:db.part/user -102]
   :db/ident :memory.shapes.xor/interval-ends-at
   :dt/type :mm.shape/XorConstraint
   :mm.shape.xor/slot-a :mm.interval/ends-at-instant
   :mm.shape.xor/slot-b :mm.interval/ends-at-time}

  ;; The 2 :mm/Shape entities referencing the sub-entities via tempid
  {:db/ident                 :memory.shapes/interval-begins-at-xor
   :dt/type                  :mm/Shape
   :mm.shape/shape-id        "interval-begins-at-xor"
   :mm.shape/applies-to      :mm/Interval
   :mm.shape/description     "XOR constraint enforcing exactly-one of (:mm.interval/begins-at-instant ref form, :mm.interval/begins-at-time literal form) populated per :mm/Interval instance — the begins-at side of the Option ε paired-property pattern for Phase D Temporal Tier-2."
   :mm.shape/severity        :violation
   :mm.shape/xor-constraints [#db/id[:db.part/user -101]]}

  {:db/ident                 :memory.shapes/interval-ends-at-xor
   :dt/type                  :mm/Shape
   :mm.shape/shape-id        "interval-ends-at-xor"
   :mm.shape/applies-to      :mm/Interval
   :mm.shape/description     "XOR constraint enforcing exactly-one of (:mm.interval/ends-at-instant ref form, :mm.interval/ends-at-time literal form) populated per :mm/Interval instance — the ends-at side of the Option ε paired-property pattern for Phase D Temporal Tier-2."
   :mm.shape/severity        :violation
   :mm.shape/xor-constraints [#db/id[:db.part/user -102]]}]

