;;;
;;;  Twit Datatype
;;;

 [
  {:db/id #db/id[:db.part/user -1]
   :db/ident :Twit
   :type :type
   :subclass-of :User
   :namespace "model"
   :name "Twit"
   :db/doc "Twitter User."
   :slots [:twit/name
              :twit/id
              :twit/namestring
              :twit/description
              :twit/suspended
              :twit/url
              :twit/lang
              :twit/image-url
              :twit/location
              :twit/geo-enabled
              :twit/follows
              :twit/created]}
  ]

