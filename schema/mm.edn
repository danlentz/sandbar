;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

 [{:db/ident       :mm.shape/shape-id
   :dt/type        :dt/Property
   :dt/domain      :mm/Shape
   :dt/range       :db.type/string
   :db/valueType   :db.type/string
