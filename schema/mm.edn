[
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; mm/* — Memory-Model Substrate Classes
;;
;; Models corpus markdown memorials at multiple granularities.  Per Dan's
;; 2026-05-12 directive (decisions/mm_memory_schema_models_markdown_at_multiple_granularities_2026_05_12.md)
;; + codec arc Stage B.0 ADR
;; (decisions/mm_section_schema_path_derived_idents_sibling_chain_navigation_2026_05_13.md)
;; for the pairwise sibling-chain shape.
;;
;; Class hierarchy:
;;
;;   :mm/Memory          — corpus memorial; one per markdown document
;;     ├── frontmatter (:mm.memory/frontmatter ref :mm/Frontmatter)
;;     ├── tags        (:mm.memory/tags many-ref :mm/Tag)
;;     ├── first-section (:mm.memory/first-section ref :mm/Section)
;;     ├── links       (:mm.memory/links many-ref :mm/Link)
;;     └── well-known frontmatter scalars as direct properties
;;
;;   :mm/Section         — addressable markdown section within a memorial
;;     ├── heading + heading-level
;;     ├── body (verbatim; child sections excluded)
;;     ├── parent (mm/Memory for top-level; mm/Section for nested)
;;     ├── next-sibling + previous-sibling (SIOC-pairwise chain)
;;     └── children walkable via :_mm.section/parent reverse-index
;;
;;   :mm/Frontmatter     — long-tail / per-type frontmatter keys
;;   :mm/Tag             — canonical tag entity; unique by :mm.tag/value
;;   :mm/Link            — markdown link extracted from body content
;;
;; Substrate landing per Stage B of
;; plans/sandbar_codex_review_remediation_arc_2026_05_13.md +
;; codex MUST-FIX #3 resolution (mm/* documented but not loaded → load it).
;;
;; Previously declared corpus-side at etc/lib/sandbar_mm_schema.clj;
;; that file becomes legacy once Sandbar 0.1.0 ships with this schema.
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Forward Declarations
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

 [{:db/ident :mm/Tag             :db/doc "A canonical tag entity"}
  {:db/ident :mm/Link            :db/doc "A markdown link extracted from memorial body"}
  {:db/ident :mm/Section         :db/doc "An addressable markdown section within a memorial"}
  {:db/ident :mm/Frontmatter     :db/doc "Long-tail / per-type frontmatter keys"}
  {:db/ident :mm/Memory          :db/doc "A corpus memorial markdown document"}
  {:db/ident :mm/Actor           :db/doc "A first-class agent/actor entity (ai-actor, human-actor); per decisions/actor_as_first_class_metamodel_class_with_mm_actor_slots_2026_05_20.md"}
  {:db/ident :mm/Context         :db/doc "A runtime context entity — the unit firewall + authorization rules attach to; per decisions/actor_as_first_class_metamodel_class_with_mm_actor_slots_2026_05_20.md + decisions/actor_as_first_class_type_2026_05_11.md §D4"}
  {:db/ident :mm/Rule            :db/doc "A first-class discipline rule entity with event + enforcement + dispatch semantics; per decisions/actor_as_first_class_metamodel_class_with_mm_actor_slots_2026_05_20.md + decisions/firewall_procedure_as_first_class_type_2026_05_11.md"}
  ;; New classes per decisions/tag_as_first_class_introspectable_type_in_metamodel_2026_05_20.md ADR §2.2
  {:db/ident :mm/ConceptScheme   :db/doc "Tag-vocabulary scheme (analog of skos:ConceptScheme); see ADR §2.2"}
  {:db/ident :mm/Dataset         :db/doc "Named dataset with declared vocabulary uses (analog of void:Dataset); see ADR §2.2"}
  {:db/ident :mm/Vocabulary      :db/doc "Vocabulary identifier (e.g. :vocab/skos); see ADR §2.2"}
  {:db/ident :mm/Linkset         :db/doc "Inter-dataset typed cross-link metadata (analog of void:Linkset); see ADR §2.2"}
  {:db/ident :mm/Shape           :db/doc "SHACL-semantics shape definition for machine-checkable validation; see ADR §2.2"}
  {:db/ident :mm/ThesaurusArray  :db/doc "Sibling-concept grouping with NodeLabel (analog of iso-thes:ThesaurusArray); see ADR §2.2"}
  {:db/ident :mm/ConceptGroup    :db/doc "Cross-cutting facet membership (analog of iso-thes:ConceptGroup); see ADR §2.2"}]

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; mm.tag/* Properties
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

 [{:db/ident       :mm.tag/value
   :dt/type        :dt/Property
   :dt/domain      :mm/Tag
   :dt/range       :db.type/string
   :db/valueType   :db.type/string
   :db/cardinality :db.cardinality/one
   :db/unique      :db.unique/identity
   :db/fulltext    true
   :db/doc "The tag string itself (e.g. 'audit', 'datomic-multi-store').  Unique identity so multiple memorials with the same tag value reference one mm/Tag entity.  Fulltext-indexed for tag-keyword search via sandbar.search/search-bm25f.  TIER A IDENTITY per decisions/tag_as_first_class_introspectable_type_in_metamodel_2026_05_20.md ADR §2.1 — preferred canonical label (SKOS prefLabel analog)."}

  ;; ============================================================================
  ;; Tier A — Identity (per ADR §2.1)
  ;; ============================================================================

  {:db/ident       :mm.tag/alt-label
   :dt/type        :dt/Property
   :dt/domain      :mm/Tag
   :dt/range       :db.type/string
   :db/valueType   :db.type/string
   :db/cardinality :db.cardinality/many
   :db/fulltext    true
   :db/doc "Alternative labels for the tag — synonyms, plurals, abbreviations.  SKOS altLabel analog.  Multi-valued.  Fulltext-indexed for search recall on non-canonical forms.  Per decisions/tag_as_first_class_introspectable_type_in_metamodel_2026_05_20.md ADR §2.1 Tier A."}

  {:db/ident       :mm.tag/hidden-label
   :dt/type        :dt/Property
   :dt/domain      :mm/Tag
   :dt/range       :db.type/string
   :db/valueType   :db.type/string
   :db/cardinality :db.cardinality/many
   :db/fulltext    true
   :db/doc "Hidden labels for search recall only — typos, deprecated forms, misspellings.  SKOS hiddenLabel analog.  Present in fulltext index but NOT shown as canonical or alternative.  Multi-valued.  Per decisions/tag_as_first_class_introspectable_type_in_metamodel_2026_05_20.md ADR §2.1 Tier A."}

  ;; ============================================================================
  ;; Tier B — Documentation (per ADR §2.1)
  ;; ============================================================================

  {:db/ident       :mm.tag/definition
   :dt/type        :dt/Property
   :dt/domain      :mm/Tag
   :dt/range       :db.type/string
   :db/valueType   :db.type/string
   :db/cardinality :db.cardinality/one
   :db/fulltext    true
   :db/doc "Formal canonical definition of the tag.  SKOS definition analog.  One-paragraph canonical narrative.  Per ADR §2.1 Tier B."}

  {:db/ident       :mm.tag/scope-note
   :dt/type        :dt/Property
   :dt/domain      :mm/Tag
   :dt/range       :db.type/string
   :db/valueType   :db.type/string
   :db/cardinality :db.cardinality/one
   :db/fulltext    true
   :db/doc "When-to-use / when-NOT-to-use note for the tag.  SKOS scopeNote analog.  The 'express intent' property per Dan-directive 2026-05-20 — every canonical tag MUST have a scope-note before sandbar.tag.define accepts it.  Per ADR §2.1 Tier B."}

  {:db/ident       :mm.tag/example
   :dt/type        :dt/Property
   :dt/domain      :mm/Tag
   :dt/range       :db.type/string
   :db/valueType   :db.type/string
   :db/cardinality :db.cardinality/many
   :db/doc "Concrete usage examples of the tag in action.  SKOS example analog.  Multi-valued.  Per ADR §2.1 Tier B."}

  {:db/ident       :mm.tag/editorial-note
   :dt/type        :dt/Property
   :dt/domain      :mm/Tag
   :dt/range       :db.type/string
   :db/valueType   :db.type/string
   :db/cardinality :db.cardinality/one
   :db/doc "Vocabulary-maintainer private notes for the tag.  SKOS editorialNote analog.  Not shown to consumers; only relevant to vocabulary curation.  Per ADR §2.1 Tier B."}

  {:db/ident       :mm.tag/change-note
   :dt/type        :dt/Property
   :dt/domain      :mm/Tag
   :dt/range       :db.type/string
   :db/valueType   :db.type/string
   :db/cardinality :db.cardinality/many
   :db/doc "What changed and why — lifecycle audit trail entries.  SKOS changeNote analog.  Multi-valued; append-only.  Per ADR §2.1 Tier B."}

  {:db/ident       :mm.tag/history-note
   :dt/type        :dt/Property
   :dt/domain      :mm/Tag
   :dt/range       :db.type/string
   :db/valueType   :db.type/string
   :db/cardinality :db.cardinality/many
   :db/doc "Past meanings of the tag.  SKOS historyNote analog.  Preserves narrative continuity when tag meaning shifts.  Multi-valued.  Per ADR §2.1 Tier B."}

  ;; ============================================================================
  ;; Tier C — Concept relations (per ADR §2.1)
  ;; ============================================================================

  {:db/ident       :mm.tag/broader-generic
   :dt/type        :dt/Property
   :dt/domain      :mm/Tag
   :dt/range       :mm/Tag
   :db/valueType   :db.type/ref
   :db/cardinality :db.cardinality/many
   :db/doc "Generic class-superclass hierarchical relation (is-a).  ISO 25964 broaderGeneric analog.  Sub-property of skos:broader.  Transitive + acyclic (enforced by audit).  Per ADR §2.1 Tier C."}

  {:db/ident       :mm.tag/broader-instantial
   :dt/type        :dt/Property
   :dt/domain      :mm/Tag
   :dt/range       :mm/Tag
   :db/valueType   :db.type/ref
   :db/cardinality :db.cardinality/many
   :db/doc "Instance-class hierarchical relation (instance-of).  ISO 25964 broaderInstantial analog.  Sub-property of skos:broader.  Per ADR §2.1 Tier C."}

  {:db/ident       :mm.tag/broader-partitive
   :dt/type        :dt/Property
   :dt/domain      :mm/Tag
   :dt/range       :mm/Tag
   :db/valueType   :db.type/ref
   :db/cardinality :db.cardinality/many
   :db/doc "Part-whole hierarchical relation.  ISO 25964 broaderPartitive analog.  Sub-property of skos:broader.  Transitive.  Per ADR §2.1 Tier C."}

  {:db/ident       :mm.tag/related
   :dt/type        :dt/Property
   :dt/domain      :mm/Tag
   :dt/range       :mm/Tag
   :db/valueType   :db.type/ref
   :db/cardinality :db.cardinality/many
   :db/doc "Symmetric associative relation; non-hierarchical 'see also' link between tags.  SKOS related analog.  Symmetric + irreflexive (enforced by audit).  Per ADR §2.1 Tier C."}

  {:db/ident       :mm.tag/in-scheme
   :dt/type        :dt/Property
   :dt/domain      :mm/Tag
   :dt/range       :mm/ConceptScheme
   :db/valueType   :db.type/ref
   :db/cardinality :db.cardinality/many
   :db/doc "Microthesaurus / scheme membership.  SKOS inScheme + ISO 25964 microThesaurusOf analog.  A tag may belong to multiple concept schemes (sandbar substrate scheme + consumer corpus scheme + federated scheme).  Per ADR §2.1 Tier C."}

  ;; ============================================================================
  ;; Tier D — Lifecycle (per ADR §2.1)
  ;; ============================================================================

  {:db/ident       :mm.tag/vocabulary-level
   :dt/type        :dt/Property
   :dt/domain      :mm/Tag
   :dt/range       :db.type/keyword
   :db/valueType   :db.type/keyword
   :db/cardinality :db.cardinality/one
   :db/doc "Z39.19 four-type vocabulary lattice level: :list (flat enumeration; only :value populated), :synonym-ring (adds :alt-label), :taxonomy (adds :broader-* hierarchy), :thesaurus (full set).  Signals which other slots are populated; enables graduated tag-vocabulary structure (start as list; promote to thesaurus as substance accumulates).  Per ADR §2.1 Tier D."}

  {:db/ident       :mm.tag/lifecycle-status
   :dt/type        :dt/Property
   :dt/domain      :mm/Tag
   :dt/range       :db.type/keyword
   :db/valueType   :db.type/keyword
   :db/cardinality :db.cardinality/one
   :db/doc "Lifecycle state: :active (canonical; in use), :draft (proposed; not yet ready for use), :deprecated (still queryable for backwards compat but new use discouraged), :retired (frontmatter rewritten away; archived).  Per ADR §2.1 Tier D + Stage 2.A SO burnination + Stage 2.B Wikipedia CfD patterns."}

  {:db/ident       :mm.tag/superseded-by
   :dt/type        :dt/Property
   :dt/domain      :mm/Tag
   :dt/range       :mm/Tag
   :db/valueType   :db.type/ref
   :db/cardinality :db.cardinality/one
   :db/doc "Lifecycle dagger — the canonical tag that replaces this one.  DC replaces analog + predicates-as-first-class lifecycle pattern.  Asymmetric + acyclic.  Per ADR §2.1 Tier D."}

  {:db/ident       :mm.tag/category-type
   :dt/type        :dt/Property
   :dt/domain      :mm/Tag
   :dt/range       :db.type/keyword
   :db/valueType   :db.type/keyword
   :db/cardinality :db.cardinality/one
   :db/doc "Content vs process vs admin distinction (per Wikipedia hidden-categories pattern; Stage 2.B finding).  :content (subject classification visible to all consumers), :process (workflow/lifecycle markers), :admin (vocabulary-maintenance internals).  Per ADR §2.1 Tier D."}

  {:db/ident       :mm.tag/canonical?
   :dt/type        :dt/Property
   :dt/domain      :mm/Tag
   :dt/range       :db.type/boolean
   :db/valueType   :db.type/boolean
   :db/cardinality :db.cardinality/one
   :db/doc "Is this tag the canonical form, or a redirect-shape to one?  True for canonical preferred forms; false for variants that should route to a canonical via :superseded-by + :alt-label.  Per ADR §2.1 Tier D."}

  ;; ============================================================================
  ;; Tier E — Federation + provenance + validation (per ADR §2.1)
  ;; ============================================================================

  {:db/ident       :mm.tag/introduced-in
   :dt/type        :dt/Property
   :dt/domain      :mm/Tag
   :dt/range       :db.type/string
   :db/valueType   :db.type/string
   :db/cardinality :db.cardinality/one
   :db/doc "Schema-version provenance — which sandbar/bootstrap version introduced this tag.  Per ADR §2.1 Tier E + predicates-as-first-class pattern."}

  {:db/ident       :mm.tag/constraints
   :dt/type        :dt/Property
   :dt/domain      :mm/Tag
   :dt/range       :mm/Shape
   :db/valueType   :db.type/ref
   :db/cardinality :db.cardinality/many
   :db/doc "Machine-checkable usage constraints — references to :mm/Shape instances enforcing per-tag invariants.  SHACL-targeted per Dan-affirmation 2026-05-20 'shacl has been an early commitment and wise investment as a foundational ontology'.  Wikidata-constraint-property analog + PoolParty's commercial SHACL adoption validation.  Per ADR §2.1 Tier E."}

  {:db/ident       :mm.tag/sort-key
   :dt/type        :dt/Property
   :dt/domain      :mm/Tag
   :dt/range       :db.type/string
   :db/valueType   :db.type/string
   :db/cardinality :db.cardinality/one
   :db/doc "Display ordering distinct from canonical name (Wikipedia sortkey pattern).  Useful when canonical name doesn't sort correctly (e.g. 'Rich Hickey' sorts as 'Hickey, Rich' via this slot).  Per ADR §2.1 Tier E."}

  ;; --- Mapping relations (ISO 25964 Part 2 + IPTC NewsCodes pattern) ---

  {:db/ident       :mm.tag/exact-match
   :dt/type        :dt/Property
   :dt/domain      :mm/Tag
   :dt/range       :mm/Tag
   :db/valueType   :db.type/ref
   :db/cardinality :db.cardinality/many
   :db/doc "Inter-vocabulary mapping — this tag is exactly equivalent to the target tag (typically in a different concept scheme).  SKOS exactMatch + ISO 25964 Part 2 + IPTC operational pattern.  Per ADR §2.1 Tier E."}

  {:db/ident       :mm.tag/close-match
   :dt/type        :dt/Property
   :dt/domain      :mm/Tag
   :dt/range       :mm/Tag
   :db/valueType   :db.type/ref
   :db/cardinality :db.cardinality/many
   :db/doc "Inter-vocabulary mapping — this tag is similar but not interchangeable in all cases.  SKOS closeMatch.  Per ADR §2.1 Tier E."}

  {:db/ident       :mm.tag/broader-match
   :dt/type        :dt/Property
   :dt/domain      :mm/Tag
   :dt/range       :mm/Tag
   :db/valueType   :db.type/ref
   :db/cardinality :db.cardinality/many
   :db/doc "Inter-vocabulary mapping — this tag is broader than the target (in the target vocabulary).  SKOS broaderMatch.  Per ADR §2.1 Tier E."}

  {:db/ident       :mm.tag/narrower-match
   :dt/type        :dt/Property
   :dt/domain      :mm/Tag
   :dt/range       :mm/Tag
   :db/valueType   :db.type/ref
   :db/cardinality :db.cardinality/many
   :db/doc "Inter-vocabulary mapping — this tag is narrower than the target.  SKOS narrowerMatch.  Per ADR §2.1 Tier E."}

  {:db/ident       :mm.tag/related-match
   :dt/type        :dt/Property
   :dt/domain      :mm/Tag
   :dt/range       :mm/Tag
   :db/valueType   :db.type/ref
   :db/cardinality :db.cardinality/many
   :db/doc "Inter-vocabulary mapping — this tag is associatively related to the target (non-hierarchical).  SKOS relatedMatch.  Per ADR §2.1 Tier E."}]

