   :db/doc "Semantic version of the concept scheme (e.g. '1.0.0').  Enables version-aware loading per consumer.  Per ADR §2.2."}

  {:db/ident       :mm.concept-scheme/description
   :dt/type        :dt/Property
   :dt/domain      :mm/ConceptScheme
   :dt/range       :db.type/string
   :db/valueType   :db.type/string
   :db/cardinality :db.cardinality/one
   :db/fulltext    true
   :db/doc "Human-readable description of the scheme's scope + purpose.  Per ADR §2.2."}

  {:db/ident       :mm.concept-scheme/license
   :dt/type        :dt/Property
   :dt/domain      :mm/ConceptScheme
   :dt/range       :db.type/keyword
   :db/valueType   :db.type/keyword
   :db/cardinality :db.cardinality/one
   :db/doc "License keyword for the vocabulary (e.g. :cc-by-4.0; :public-domain; :proprietary).  Per ADR §2.2 + IPTC CC-BY-4.0 federation-at-scale enabler pattern."}]

