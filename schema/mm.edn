  {:db/ident         :mm/Memory
   :dt/type          :dt/Class
   :dt/subclass-of   :dt/Resource
   :dt/context       "mm"
   :dt/label         "Memory"
   :dt/native-codec  :markdown
   :dt/memorial-policy :first-class                       ;; inherited by descendants via class-hierarchy walk per first-class-memorialization arc
   ;; Default search ordering (D4c, 2026-09-19): a memorial that some other
   ;; memorial `supersedes` (the corpus asserts supersession one-sidedly on
   ;; the successor; `_supersedes` is the reverse-reference form, resolved
   ;; once per search), or that carries a superseded-by edge or a superseded
   ;; status, orders below a current hit of comparable relevance; among
   ;; equals the more recently touched comes first.  Read via
   ;; dt/effective-superseded-when-of + dt/effective-recency-slot-of by
   ;; sandbar.search/search-bm25f; :rank-by :relevance opts out.
   :dt/superseded-when [[:mm.memory/_supersedes   :some]
                        [:mm.memory/superseded-by :some]
                        [:mm.memory/status        :superseded]]
   :dt/recency-slot    :mm.memory/last-touched
   :dt/codec-aliases [[:type :mm.memory/memory-type]]
   :dt/bm25f-weights [[:mm.memory/name        12.0]
                      [:mm.memory/description  8.0]
                      [:mm.memory/themes       6.0]    ;; canonical-tag DCAT-tier ref → :mm/Tag (resolved via ref-target-text tokenizer; Phase B)
                      [:mm.memory/tags         4.0]    ;; free-text-mixed-tag ref → :mm/Tag (same tokenizer; lower weight per DCAT two-tier convention)
                      [:mm.memory/rel-path     3.0]
                      [:mm.memory/body-raw     1.0]]
   ;; Canonical frontmatter emit order — slots not listed here are appended
   ;; at the end in entity-key iteration order.  Body / structural slots
   ;; (:mm.memory/body-raw, :mm.memory/first-section, :mm.memory/links) are
   ;; INTENTIONALLY OMITTED — they don't surface in frontmatter.
   ;; Per decisions/slot_order_declared_by_class_introspectable_2026_05_20.md.
   :dt/codec-slot-order
   [;; Identity tier
    [:mm.memory/name             0]
    [:mm.memory/description      1]
    [:mm.memory/memory-type      2]
    [:mm.memory/scope            3]
    [:mm.memory/priority         4]
    [:mm.memory/status           5]
    ;; Provenance tier
    [:mm.memory/created          6]
    [:mm.memory/last-touched     7]
    [:mm.memory/last-reviewed    8]
    [:mm.memory/created-by       9]
    [:mm.memory/importance      10]
    ;; Typed-edge tier (relations to other memories)
    [:mm.memory/parent          11]
    [:mm.memory/part-of         12]
    [:mm.memory/has-part        13]
    [:mm.memory/descends-from   14]
    [:mm.memory/cites           15]
    [:mm.memory/evidenced-by    16]
    [:mm.memory/evidences       17]
    [:mm.memory/documented-by   18]
    [:mm.memory/documents       19]
    [:mm.memory/triggered-by    20]
    [:mm.memory/touches         21]
    [:mm.memory/motivated-by    22]
    [:mm.memory/motivates       23]
    [:mm.memory/composes-with   24]
    [:mm.memory/refines         25]
    [:mm.memory/supersedes      26]
    [:mm.memory/superseded-by   27]
    [:mm.memory/conforms-to     28]
    [:mm.memory/informs         29]
    [:mm.memory/informed-by     30]
    [:mm.memory/implements      31]
    [:mm.memory/introduced-in   32]
    [:mm.memory/related         33]
    ;; Classification tier
    [:mm.memory/themes          34]
    [:mm.memory/tags            35]
    ;; Long-tail
    [:mm.memory/frontmatter     36]]
   :dt/slots         [:mm.memory/identity :mm.memory/rel-path :mm.memory/name
                      :mm.memory/description :mm.memory/memory-type
                      :mm.memory/scope :mm.memory/status
                      :mm.memory/created :mm.memory/last-touched
                      :mm.memory/last-reviewed :mm.memory/created-by
                      :mm.memory/importance :mm.memory/tags
                      :mm.memory/themes                          ;; ADR §2.3 DCAT controlled-vocabulary tier
                      :mm.memory/frontmatter :mm.memory/first-section
                      :mm.memory/links :mm.memory/body-raw
                      ;; Typed-edge slots (sub-arc Stage 2.A; F#14 resolution)
                      :mm.memory/related :mm.memory/cites
                      :mm.memory/motivated-by :mm.memory/motivates
                      :mm.memory/composes-with :mm.memory/refines
                      :mm.memory/supersedes :mm.memory/superseded-by
                      :mm.memory/conforms-to
                      :mm.memory/part-of :mm.memory/has-part
                      :mm.memory/descends-from
                      :mm.memory/evidenced-by :mm.memory/evidences
                      :mm.memory/documented-by :mm.memory/documents
                      :mm.memory/triggered-by :mm.memory/touches
                      :mm.memory/parent
                      :mm.memory/informs :mm.memory/informed-by
                      ;; D6 (2026-09-19): declared-but-unlisted properties listed, so the
                      ;; codec's resolver finds them and the edge is traversable (MF-1).
                      ;; :mm/id, :mm/pref-label and :mm/alt-label are declared in
                      ;; mm-namespace.edn, which loads AFTER this file, so they join
                      ;; this vector from there (a plain :db/add each) — see its tail.
                      :mm.memory/bootstrap-source :mm.memory/bootstrap-override
                      ;; both directions of the example-of-concept pair live here
                      ;; (their :dt/domain is :mm/Memory); :mm/Example lists
                      ;; demonstrates again as its own required slot, and the
                      ;; firewall's flow census governs both (label_test pins the
                      ;; census ⊆ effective-ref-surface invariant on :mm/Memory).
                      :mm.memory/demonstrates :mm.memory/demonstrated-by
                      :mm.memory/implements
                      :mm.memory/introduced-in
                      ;; S6 firewall slots (MF-1: owning-project is a REF — MUST be
                      ;; here to materialize as a traversable edge, not carrier text)
                      :mm.memory/visibility
                      :mm.memory/owning-project]
   :dt/abstract?     false
   :db/doc "A corpus memorial — a markdown document under memory/ with YAML frontmatter and a markdown body.  Decomposed at multiple granularities: well-known frontmatter as direct properties; long-tail frontmatter via mm/Frontmatter; tags via mm/Tag refs; body as a sibling chain of mm/Section entities reachable via :mm.memory/first-section + :mm.section/next-sibling walk; markdown links via mm/Link refs."}]

