[
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; mm/* — Memory-Model Substrate Classes
;;
;; Models corpus markdown memorials at multiple granularities.  Per Dan's
;; 2026-05-12 directive (decisions/mm_memory_schema_models_markdown_at_multiple_granularities_2026_05_12.md)
;; + codec arc Stage B.0 ADR
;; (decisions/mm_section_schema_path_derived_idents_sibling_chain_navigation_2026_05_13.md)
;; for the pairwise sibling-chain shape.
;;
;; Class hierarchy:
;;
;;   :mm/Memory          — corpus memorial; one per markdown document
;;     ├── frontmatter (:mm.memory/frontmatter ref :mm/Frontmatter)
;;     ├── tags        (:mm.memory/tags many-ref :mm/Tag)
;;     ├── first-section (:mm.memory/first-section ref :mm/Section)
;;     ├── links       (:mm.memory/links many-ref :mm/Link)
;;     └── well-known frontmatter scalars as direct properties
;;
;;   :mm/Section         — addressable markdown section within a memorial
;;     ├── heading + heading-level
;;     ├── body (verbatim; child sections excluded)
;;     ├── parent (mm/Memory for top-level; mm/Section for nested)
;;     ├── next-sibling + previous-sibling (SIOC-pairwise chain)
;;     └── children walkable via :_mm.section/parent reverse-index
;;
;;   :mm/Frontmatter     — long-tail / per-type frontmatter keys
;;   :mm/Tag             — canonical tag entity; unique by :mm.tag/value
;;   :mm/Link            — markdown link extracted from body content
;;
;; Substrate landing per Stage B of
;; plans/sandbar_codex_review_remediation_arc_2026_05_13.md +
;; codex MUST-FIX #3 resolution (mm/* documented but not loaded → load it).
;;
;; Previously declared corpus-side at etc/lib/sandbar_mm_schema.clj;
;; that file becomes legacy once Sandbar 0.1.0 ships with this schema.
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Forward Declarations
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

 [{:db/ident :mm/Tag         :db/doc "A canonical tag entity"}
  {:db/ident :mm/Link        :db/doc "A markdown link extracted from memorial body"}
  {:db/ident :mm/Section     :db/doc "An addressable markdown section within a memorial"}
  {:db/ident :mm/Frontmatter :db/doc "Long-tail / per-type frontmatter keys"}
  {:db/ident :mm/Memory      :db/doc "A corpus memorial markdown document"}]

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; mm.tag/* Properties
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

 [{:db/ident       :mm.tag/value
   :dt/type        :dt/Property
   :dt/domain      :mm/Tag
   :dt/range       :db.type/string
   :db/valueType   :db.type/string
   :db/cardinality :db.cardinality/one
   :db/unique      :db.unique/identity
   :db/fulltext    true
   :db/doc "The tag string itself (e.g. 'audit', 'datomic-multi-store').  Unique identity so multiple memorials with the same tag value reference one mm/Tag entity.  Fulltext-indexed for tag-keyword search via sandbar.search/search-bm25f."}]

