;; mm.concept-scheme/* Properties — per ADR §2.2 :mm/ConceptScheme class
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

 [{:db/ident       :mm.concept-scheme/scheme-id
   :dt/type        :dt/Property
   :dt/domain      :mm/ConceptScheme
   :dt/range       :db.type/string
   :db/valueType   :db.type/string
