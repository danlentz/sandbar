;; Class Definitions
;;
;; Each class is :dt/type :dt/Class + :dt/subclass-of :dt/Resource.  Memory
;; classes carrying markdown content declare :dt/native-codec :markdown
;; so the codec mediator's class-default resolution finds a codec without
;; explicit format hint.  :mm/Memory declares :dt/codec-aliases for
;; the :type frontmatter key (which would otherwise collide with the
;; :dt/type system attribute).
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

 [{:db/ident             :mm/Tag
   :dt/type              :dt/Class
   :dt/subclass-of       :dt/Resource
   :dt/context           "mm"
   :dt/label             "Tag"
   :dt/native-codec      :markdown                         ;; tag memorials are markdown documents
   :dt/memorial-policy   :inline                           ;; serialized within host memorial's :mm.memory/tags slot; cardinality makes per-tag fs files impractical
   :dt/codec-type-keyword :tag                             ;; frontmatter `type: tag` routes to :mm/Tag (Stage 7.C class-routing)
   :dt/bm25f-weights     [[:mm.tag/value         12.0]
                          [:mm.tag/alt-label      8.0]
                          [:mm.tag/definition     6.0]
                          [:mm.tag/scope-note     4.0]
                          [:mm.tag/hidden-label   2.0]
                          [:mm.tag/example        1.0]]
   :dt/slots             [;; Tier A — Identity (per ADR §2.1)
                          :mm.tag/value
                          :mm.tag/alt-label
                          :mm.tag/hidden-label
                          ;; Tier B — Documentation
                          :mm.tag/definition
                          :mm.tag/scope-note
                          :mm.tag/example
                          :mm.tag/editorial-note
                          :mm.tag/change-note
                          :mm.tag/history-note
                          ;; Tier C — Concept relations
                          :mm.tag/broader-generic
                          :mm.tag/broader-instantial
                          :mm.tag/broader-partitive
                          :mm.tag/related
                          :mm.tag/in-scheme
                          ;; Tier D — Lifecycle
                          :mm.tag/vocabulary-level
                          :mm.tag/lifecycle-status
                          :mm.tag/superseded-by
                          :mm.tag/category-type
                          :mm.tag/canonical?
                          ;; Tier E — Federation + provenance + validation
                          :mm.tag/introduced-in
                          :mm.tag/constraints
                          :mm.tag/sort-key
                          :mm.tag/exact-match
                          :mm.tag/close-match
                          :mm.tag/broader-match
                          :mm.tag/narrower-match
                          :mm.tag/related-match]
   :dt/abstract?         false
   :db/doc "An introspectable vocabulary concept with labels, definition, scope, relationships, lifecycle and mapping metadata. Having :dt/type :mm/Tag does not imply :mm.tag/canonical? is true. Lightweight value carriers may exist without this type; read tools distinguish that population."}

  {:db/ident         :mm/Link
   :dt/type          :dt/Class
   :dt/subclass-of   :dt/Resource
   :dt/context       "mm"
   :dt/label         "Link"
   :dt/slots         [:mm.link/href :mm.link/text :mm.link/in-section
                      :mm.link/external? :mm.link/target-memory]
   :dt/abstract?     false
   :db/doc "A markdown link extracted from memorial body content.  href + text preserved; in-section refers back to the containing mm/Section; external? distinguishes corpus-internal vs external URLs; target-memory references the linked mm/Memory if internal."}

  {:db/ident         :mm/Section
   :dt/type          :dt/Class
   :dt/subclass-of   :dt/Resource
   :dt/context       "mm"
   :dt/label         "Section"
   :dt/native-codec  :markdown
   :dt/bm25f-weights [[:mm.section/heading 6.0]
                      [:mm.section/body    1.0]]
   :dt/slots         [:mm.section/heading :mm.section/heading-level
                      :mm.section/body :mm.section/parent
                      :mm.section/next-sibling :mm.section/previous-sibling]
   :dt/abstract?     false
   :db/doc "One markdown section within a memorial's body.  Each section is an addressable entity carrying :mm.section/parent for nesting + :mm.section/next-sibling / :mm.section/previous-sibling for ordered traversal (SIOC pairwise pattern; bidirectional symmetry; point-local O(1) neighbor lookup).  Children reachable via :_mm.section/parent reverse-walk.  :mm.section/body holds the markdown content BETWEEN this heading and the FIRST sub-section's heading."}

  {:db/ident         :mm/Frontmatter
   :dt/type          :dt/Class
   :dt/subclass-of   :dt/Resource
   :dt/context       "mm"
   :dt/label         "Frontmatter"
   :dt/slots         [:mm.frontmatter/extra]
   :dt/abstract?     false
   :db/doc "Container for unknown / per-type frontmatter keys.  Well-known frontmatter keys (name, description, type, etc.) live directly on mm/Memory; the long tail goes here as a structured EDN map."}

