[
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; mm/* — Memory-Model Substrate Classes
;;
;; Models corpus markdown memorials at multiple granularities.  Per Dan's
;; 2026-05-12 directive (decisions/mm_memory_schema_models_markdown_at_multiple_granularities_2026_05_12.md)
;; + codec arc Stage B.0 ADR
;; (decisions/mm_section_schema_path_derived_idents_sibling_chain_navigation_2026_05_13.md)
;; for the pairwise sibling-chain shape.
;;
;; Class hierarchy:
;;
;;   :mm/Memory          — corpus memorial; one per markdown document
;;     ├── frontmatter (:mm.memory/frontmatter ref :mm/Frontmatter)
;;     ├── tags        (:mm.memory/tags many-ref :mm/Tag)
;;     ├── first-section (:mm.memory/first-section ref :mm/Section)
;;     ├── links       (:mm.memory/links many-ref :mm/Link)
;;     └── well-known frontmatter scalars as direct properties
;;
;;   :mm/Section         — addressable markdown section within a memorial
;;     ├── heading + heading-level
;;     ├── body (verbatim; child sections excluded)
;;     ├── parent (mm/Memory for top-level; mm/Section for nested)
;;     ├── next-sibling + previous-sibling (SIOC-pairwise chain)
;;     └── children walkable via :_mm.section/parent reverse-index
;;
;;   :mm/Frontmatter     — long-tail / per-type frontmatter keys
;;   :mm/Tag             — canonical tag entity; unique by :mm.tag/value
;;   :mm/Link            — markdown link extracted from body content
;;
;; Substrate landing per Stage B of
;; plans/sandbar_codex_review_remediation_arc_2026_05_13.md +
;; codex MUST-FIX #3 resolution (mm/* documented but not loaded → load it).
;;
;; Previously declared corpus-side at etc/lib/sandbar_mm_schema.clj;
;; that file becomes legacy once Sandbar 0.1.0 ships with this schema.
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Forward Declarations
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

 [{:db/ident :mm/Tag             :db/doc "An introspectable vocabulary concept with labels, definition, scope, relationships, lifecycle and mapping metadata. Having :dt/type :mm/Tag does not imply :mm.tag/canonical? is true. Lightweight value carriers may exist without this type; read tools distinguish that population."}
  {:db/ident :mm/Link            :db/doc "A markdown link extracted from memorial body"}
  {:db/ident :mm/Section         :db/doc "An addressable markdown section within a memorial"}
  {:db/ident :mm/Frontmatter     :db/doc "Long-tail / per-type frontmatter keys"}
  {:db/ident :mm/Memory          :db/doc "A corpus memorial markdown document"}
  {:db/ident :mm/Actor           :db/doc "A first-class actor with memory metadata and actor-specific slots. Concrete AIActor, HumanActor and SystemActor classes inherit this surface. Actor records describe participants; their existence does not grant credentials or runtime authority."}
  {:db/ident :mm/Context         :db/doc "A runtime context with memory metadata and context-specific fields. Authorization and disclosure consumers interpret these declarations; a context entity alone does not establish isolation."}
  {:db/ident :mm/Rule            :db/doc "A first-class rule declaration, inheriting function metadata from :mm/Fn and common memory metadata. Declaring the rule does not run or enforce it; a configured consumer must do that."}
  {:db/ident :mm/BootstrapSource  :db/doc "Provenance for a bootstrap definition, identifying a substrate, human, federated or merged source. Memories refer to it through :mm.memory/bootstrap-source."}
  ;; New classes per decisions/tag_as_first_class_introspectable_type_in_metamodel_2026_05_20.md ADR §2.2
  {:db/ident :mm/ConceptScheme   :db/doc "A named vocabulary scheme, analogous to skos:ConceptScheme. Tags can participate in more than one scheme."}
  {:db/ident :mm/Dataset         :db/doc "A named dataset, analogous to void:Dataset. This is a minimal class declaration; richer dataset operations require their own implementation."}
  {:db/ident :mm/Vocabulary      :db/doc "A named vocabulary identifier, such as :vocab/skos. This is a minimal class declaration."}
  {:db/ident :mm/Linkset         :db/doc "A declaration describing links between datasets, analogous to void:Linkset. This class currently has no dedicated linkset slots."}
  {:db/ident :mm/Shape           :db/doc "A shape declaration with memory metadata, an exact target class and executable constraint fields. sandbar.shape implements a subset of SHACL-inspired checks; see the shape guide for target selection, unsupported fields and current evaluator defects."}
  {:db/ident :mm/ThesaurusArray  :db/doc "A grouping of sibling concepts, analogous to iso-thes:ThesaurusArray. This is a minimal class declaration."}
  {:db/ident :mm/ConceptGroup    :db/doc "A cross-cutting concept group, analogous to iso-thes:ConceptGroup. This is a minimal class declaration."}
  ;; Forward-decl for :mm/Fn (full def in schema/mm-meta.edn).  Needed here
  ;; because :mm.shape/validator-fn + :mm.shape/value-constraints (per SHACL
  ;; arc Stage B.5 D3 2026-05-23) declare :dt/range :mm/Fn — load-order forces
  ;; mm.edn to see :mm/Fn before mm-meta.edn loads its full declaration.
  ;; Per substrate-restart friction discovery 2026-05-23.
  {:db/ident :mm/Fn              :db/doc "Forward declaration of a first-class function. Its full definition is in schema/mm-meta.edn."}
  ;; S6 keystone-mint forward-decl for :mm/Project (full class def in
  ;; schema/mm-artifact.edn, loaded AFTER mm.edn).  Needed here because the
  ;; S6 firewall slot :mm.memory/owning-project declares :dt/range :mm/Project
  ;; (a :db.type/ref meta-attribute — meta.edn:78-82), so mm.edn's tx must see
  ;; :mm/Project as a resolvable ident before its full definition loads.
  ;; Same load-order pattern as :mm/Fn above (2026-05-23).  Per DESIGN-ONTOLOGY §2.3.
  {:db/ident :mm/Project         :db/doc "Forward decl: keystone tie-class (Codebase<->Context) + firewall-posture project record (full def in schema/mm-artifact.edn per S6 mint 2026-07-06)."}]

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; mm.tag/* Properties
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

 [{:db/ident       :mm.tag/value
   :dt/type        :dt/Property
   :dt/domain      :mm/Tag
   :dt/range       :db.type/string
   :db/valueType   :db.type/string
   :db/cardinality :db.cardinality/one
   :db/unique      :db.unique/identity
   :db/fulltext    true
   :db/doc "The tag string itself (e.g. 'audit', 'datomic-multi-store').  Unique identity so multiple memorials with the same tag value reference one mm/Tag entity.  Fulltext-indexed for tag-keyword search via sandbar.search/search-bm25f.  TIER A IDENTITY."}

  ;; ============================================================================
  ;; Tier A — Identity (per ADR §2.1)
  ;; ============================================================================

  {:db/ident       :mm.tag/alt-label
   :dt/type        :dt/Property
   :dt/domain      :mm/Tag
   :dt/range       :db.type/string
   :db/valueType   :db.type/string
   :db/cardinality :db.cardinality/many
   :db/fulltext    true
   :db/doc "Alternative labels for the tag — synonyms, plurals, abbreviations.  SKOS altLabel analog.  Multi-valued.  Fulltext-indexed for search recall on non-canonical forms."}

  {:db/ident       :mm.tag/hidden-label
   :dt/type        :dt/Property
   :dt/domain      :mm/Tag
   :dt/range       :db.type/string
   :db/valueType   :db.type/string
   :db/cardinality :db.cardinality/many
   :db/fulltext    true
   :db/doc "Alternative spellings intended for retrieval rather than preferred display, analogous to skos:hiddenLabel. Multi-valued and fulltext-indexed. The field is not confidential and may be returned by a full read."}

  ;; ============================================================================
  ;; Tier B — Documentation (per ADR §2.1)
  ;; ============================================================================

  {:db/ident       :mm.tag/definition
   :dt/type        :dt/Property
   :dt/domain      :mm/Tag
   :dt/range       :db.type/string
   :db/valueType   :db.type/string
   :db/cardinality :db.cardinality/one
   :db/fulltext    true
   :db/doc "Formal canonical definition of the tag.  SKOS definition analog.  One-paragraph canonical narrative."}

  {:db/ident       :mm.tag/scope-note
   :dt/type        :dt/Property
   :dt/domain      :mm/Tag
   :dt/range       :db.type/string
   :db/valueType   :db.type/string
   :db/cardinality :db.cardinality/one
   :db/fulltext    true
   :db/doc "Guidance on when to use the concept and when another concept is more appropriate; analogous to skos:scopeNote."}

  {:db/ident       :mm.tag/example
   :dt/type        :dt/Property
   :dt/domain      :mm/Tag
   :dt/range       :db.type/string
   :db/valueType   :db.type/string
   :db/cardinality :db.cardinality/many
   :db/doc "Concrete usage examples of the tag in action.  SKOS example analog.  Multi-valued."}

  {:db/ident       :mm.tag/editorial-note
   :dt/type        :dt/Property
   :dt/domain      :mm/Tag
   :dt/range       :db.type/string
   :db/valueType   :db.type/string
   :db/cardinality :db.cardinality/one
   :db/doc "Vocabulary-maintainer notes, analogous to skos:editorialNote. This property is not a confidentiality boundary; callers must apply the relevant output policy."}

  {:db/ident       :mm.tag/change-note
   :dt/type        :dt/Property
   :dt/domain      :mm/Tag
   :dt/range       :db.type/string
   :db/valueType   :db.type/string
   :db/cardinality :db.cardinality/many
   :db/doc "An authored account of a vocabulary change and its reason, analogous to skos:changeNote. Multi-valued; append-only behavior is an application policy, not enforced by this slot."}

  {:db/ident       :mm.tag/history-note
   :dt/type        :dt/Property
   :dt/domain      :mm/Tag
   :dt/range       :db.type/string
   :db/valueType   :db.type/string
   :db/cardinality :db.cardinality/many
   :db/doc "Past meanings of the tag.  SKOS historyNote analog.  Preserves narrative continuity when tag meaning shifts.  Multi-valued."}

  ;; ============================================================================
  ;; Tier C — Concept relations (per ADR §2.1)
  ;; ============================================================================

  {:db/ident       :mm.tag/broader-generic
   :dt/type        :dt/StrictPartialOrderProperty
   :dt/domain      :mm/Tag
   :dt/range       :mm/Tag
   :db/valueType   :db.type/ref
   :db/cardinality :db.cardinality/many
   :db/doc "Generic class-superclass hierarchical relation (is-a).  ISO 25964 broaderGeneric analog.  Sub-property of skos:broader.  Strict partial order: transitive + asymmetric + irreflexive.  Audit invariant enforces acyclicity (transitive closure via rdfs9 + prp-trp at query time)."}

  {:db/ident       :mm.tag/broader-instantial
   :dt/type        :dt/StrictPartialOrderProperty
   :dt/domain      :mm/Tag
   :dt/range       :mm/Tag
   :db/valueType   :db.type/ref
   :db/cardinality :db.cardinality/many
   :db/doc "Instance-class hierarchical relation (instance-of).  ISO 25964 broaderInstantial analog.  Sub-property of skos:broader.  Strict partial order: transitive + asymmetric + irreflexive."}

  {:db/ident       :mm.tag/broader-partitive
   :dt/type        :dt/StrictPartialOrderProperty
   :dt/domain      :mm/Tag
   :dt/range       :mm/Tag
   :db/valueType   :db.type/ref
   :db/cardinality :db.cardinality/many
   :db/doc "Part-whole hierarchical relation.  ISO 25964 broaderPartitive analog.  Sub-property of skos:broader.  Strict partial order: transitive + asymmetric + irreflexive (mereological-decomposition relations chain)."}

  {:db/ident       :mm.tag/related
   :dt/type        :dt/IrreflexiveSymmetricProperty
   :dt/domain      :mm/Tag
   :dt/range       :mm/Tag
   :db/valueType   :db.type/ref
   :db/cardinality :db.cardinality/many
   :db/doc "Symmetric associative relation; non-hierarchical 'see also' link between tags.  SKOS related analog.  Symmetric + irreflexive (enforced by audit)."}

  {:db/ident       :mm.tag/in-scheme
   :dt/type        :dt/DirectedBinaryRelationProperty
   :dt/domain      :mm/Tag
   :dt/range       :mm/ConceptScheme
   :db/valueType   :db.type/ref
   :db/cardinality :db.cardinality/many
   :db/doc "Microthesaurus / scheme membership.  SKOS inScheme + ISO 25964 microThesaurusOf analog.  A tag may belong to multiple concept schemes (sandbar substrate scheme + consumer corpus scheme + federated scheme).  Asymmetric + irreflexive (a tag is in a scheme, not vice versa; schemes don't 'in-scheme' tags)."}

  ;; ============================================================================
  ;; Tier D — Lifecycle (per ADR §2.1)
  ;; ============================================================================

  {:db/ident       :mm.tag/vocabulary-level
   :dt/type        :dt/Property
   :dt/domain      :mm/Tag
   :dt/range       :db.type/keyword
   :db/valueType   :db.type/keyword
   :db/cardinality :db.cardinality/one
   :db/doc "Z39.19 four-type vocabulary lattice level: :list (flat enumeration; only :value populated), :synonym-ring (adds :alt-label), :taxonomy (adds :broader-* hierarchy), :thesaurus (full set).  Signals which other slots are populated; enables graduated tag-vocabulary structure (start as list; promote to thesaurus as substance accumulates)."}

  {:db/ident       :mm.tag/lifecycle-status
   :dt/type        :dt/Property
   :dt/domain      :mm/Tag
   :dt/range       :db.type/keyword
   :db/valueType   :db.type/keyword
   :db/cardinality :db.cardinality/one
   :db/doc "Authored vocabulary lifecycle state, such as :active, :draft, :deprecated or :superseded. Readers interpret it alongside definitions and successor references; the value alone does not enforce an authoring policy."}

  {:db/ident       :mm.tag/superseded-by
   :dt/type        :dt/StrictPartialOrderProperty
   :dt/domain      :mm/Tag
   :dt/range       :mm/Tag
   :db/valueType   :db.type/ref
   :db/cardinality :db.cardinality/one
   :db/doc "Lifecycle dagger — the canonical tag that replaces this one.  DC replaces analog + predicates-as-first-class lifecycle pattern.  Asymmetric + acyclic."}

  {:db/ident       :mm.tag/category-type
   :dt/type        :dt/Property
   :dt/domain      :mm/Tag
   :dt/range       :db.type/keyword
   :db/valueType   :db.type/keyword
   :db/cardinality :db.cardinality/one
   :db/doc "A vocabulary category such as :content, :process or :admin. Display and retrieval consumers decide how to use it."}

  {:db/ident       :mm.tag/canonical?
   :dt/type        :dt/Property
   :dt/domain      :mm/Tag
   :dt/range       :db.type/boolean
   :db/valueType   :db.type/boolean
   :db/cardinality :db.cardinality/one
   :db/doc "An explicit editorial assertion: true marks a preferred canonical concept; false records a noncanonical form. Absence is unknown, not false. This flag alone does not redirect or merge identities."}

  ;; ============================================================================
  ;; Tier E — Federation + provenance + validation (per ADR §2.1)
  ;; ============================================================================

  {:db/ident       :mm.tag/introduced-in
   :dt/type        :dt/Property
   :dt/domain      :mm/Tag
   :dt/range       :db.type/string
   :db/valueType   :db.type/string
   :db/cardinality :db.cardinality/one
   :db/doc "Schema-version provenance — which sandbar/bootstrap version introduced this tag."}

  {:db/ident       :mm.tag/constraints
   :dt/type        :dt/DirectedBinaryRelationProperty
   :dt/domain      :mm/Tag
   :dt/range       :mm/Shape
   :db/valueType   :db.type/ref
   :db/cardinality :db.cardinality/many
   :db/doc "References to shape declarations associated with this concept. This relationship alone does not add the concept to the shape walker target-selection logic."}

  {:db/ident       :mm.tag/sort-key
   :dt/type        :dt/Property
   :dt/domain      :mm/Tag
   :dt/range       :db.type/string
   :db/valueType   :db.type/string
   :db/cardinality :db.cardinality/one
   :db/doc "Display ordering distinct from canonical name (Wikipedia sortkey pattern).  Useful when canonical name doesn't sort correctly (e.g. 'Rich Hickey' sorts as 'Hickey, Rich' via this slot)."}

  ;; --- Mapping relations (ISO 25964 Part 2 + IPTC NewsCodes pattern) ---

  {:db/ident       :mm.tag/exact-match
   :dt/type        :dt/IrreflexiveSymmetricProperty
   :dt/domain      :mm/Tag
   :dt/range       :mm/Tag
   :db/valueType   :db.type/ref
   :db/cardinality :db.cardinality/many
   :db/doc "Inter-vocabulary mapping — this tag is exactly equivalent to the target tag (typically in a different concept scheme).  SKOS exactMatch + ISO 25964 Part 2 + IPTC operational pattern.  Symmetric + irreflexive (mapping is mutual; a tag never exactMatches itself per SKOS)."}

  {:db/ident       :mm.tag/close-match
   :dt/type        :dt/IrreflexiveSymmetricProperty
   :dt/domain      :mm/Tag
   :dt/range       :mm/Tag
   :db/valueType   :db.type/ref
   :db/cardinality :db.cardinality/many
   :db/doc "Inter-vocabulary mapping — this tag is similar but not interchangeable in all cases.  SKOS closeMatch.  Symmetric + irreflexive (similarity is mutual; NOT transitive per SKOS — closeness doesn't chain via composition)."}

  {:db/ident       :mm.tag/broader-match
   :dt/type        :dt/StrictPartialOrderProperty
   :dt/domain      :mm/Tag
   :dt/range       :mm/Tag
   :db/valueType   :db.type/ref
   :db/cardinality :db.cardinality/many
   :db/doc "Inter-vocabulary mapping — this tag is broader than the target (in the target vocabulary).  SKOS broaderMatch.  Strict partial order: transitive + asymmetric + irreflexive.  Dagger pair with narrower-match — `:dt/inverse-of` relation declared in the dedicated relations-block at the bottom of mm.edn (separate tx avoids same-tx ident-resolution); OWL 2 RL prp-inv1/inv2 entailment derives both directions."}

  {:db/ident       :mm.tag/narrower-match
   :dt/type        :dt/StrictPartialOrderProperty
   :dt/domain      :mm/Tag
   :dt/range       :mm/Tag
   :db/valueType   :db.type/ref
   :db/cardinality :db.cardinality/many
   :db/doc "Inter-vocabulary mapping — this tag is narrower than the target.  SKOS narrowerMatch.  Strict partial order: transitive + asymmetric + irreflexive.  Dagger pair with broader-match — its inverse-of relation declared on the broader-match side per the substrate's one-sided assertion discipline; OWL 2 RL prp-inv1/inv2 entailment derives both directions."}

  {:db/ident       :mm.tag/related-match
   :dt/type        :dt/IrreflexiveSymmetricProperty
   :dt/domain      :mm/Tag
   :dt/range       :mm/Tag
   :db/valueType   :db.type/ref
   :db/cardinality :db.cardinality/many
   :db/doc "Inter-vocabulary mapping — this tag is associatively related to the target (non-hierarchical).  SKOS relatedMatch.  Symmetric + irreflexive (associative mapping is mutual; a tag never relatedMatches itself)."}]

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; mm.concept-scheme/* Properties — per ADR §2.2 :mm/ConceptScheme class
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

 [{:db/ident       :mm.concept-scheme/scheme-id
   :dt/type        :dt/Property
   :dt/domain      :mm/ConceptScheme
   :dt/range       :db.type/string
   :db/valueType   :db.type/string
   :db/cardinality :db.cardinality/one
   :db/unique      :db.unique/identity
   :db/doc "Unique identifier for the concept scheme (e.g. 'sandbar-substrate-tags-v1' or 'corpus-domain-tags').  Unique identity so multiple references resolve to one entity."}

  {:db/ident       :mm.concept-scheme/version
   :dt/type        :dt/Property
   :dt/domain      :mm/ConceptScheme
   :dt/range       :db.type/string
   :db/valueType   :db.type/string
   :db/cardinality :db.cardinality/one
   :db/doc "Semantic version of the concept scheme (e.g. '1.0.0').  Enables version-aware loading per consumer."}

  {:db/ident       :mm.concept-scheme/description
   :dt/type        :dt/Property
   :dt/domain      :mm/ConceptScheme
   :dt/range       :db.type/string
   :db/valueType   :db.type/string
   :db/cardinality :db.cardinality/one
   :db/fulltext    true
   :db/doc "Human-readable description of the scheme's scope + purpose."}

  {:db/ident       :mm.concept-scheme/license
   :dt/type        :dt/Property
   :dt/domain      :mm/ConceptScheme
   :dt/range       :db.type/keyword
   :db/valueType   :db.type/keyword
   :db/cardinality :db.cardinality/one
   :db/doc "License keyword for the vocabulary (e.g. :cc-by-4.0; :public-domain; :proprietary)."}]

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; mm.shape/* Properties — per ADR §2.2 :mm/Shape class (SHACL-targeted)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

 [{:db/ident       :mm.shape/shape-id
   :dt/type        :dt/Property
   :dt/domain      :mm/Shape
   :dt/range       :db.type/string
   :db/valueType   :db.type/string
   :db/cardinality :db.cardinality/one
   :db/unique      :db.unique/identity
   :db/doc "Unique identifier for the shape (e.g. 'mm-tag-canonical-shape').  Unique identity."}

  {:db/ident       :mm.shape/applies-to
   :dt/type        :dt/Property
   :dt/domain      :mm/Shape
   :dt/range       :dt/Class
   :db/valueType   :db.type/ref
   :db/cardinality :db.cardinality/one
   :db/doc "The exact declared class selected by the current shape validator and conformance report. Parent-class targeting does not automatically include subclass instances."}

  {:db/ident       :mm.shape/description
   :dt/type        :dt/Property
   :dt/domain      :mm/Shape
   :dt/range       :db.type/string
   :db/valueType   :db.type/string
   :db/cardinality :db.cardinality/one
   :db/fulltext    true
   :db/doc "Human-readable description of what the shape enforces."}

  {:db/ident       :mm.shape/required-property
   :dt/type        :dt/Property
   :dt/domain      :mm/Shape
   :dt/range       :dt/Property
   :db/valueType   :db.type/ref
   :db/cardinality :db.cardinality/many
   :db/doc "Properties that MUST be present on instances of `applies-to` class.  SHACL `sh:minCount 1` analog."}

  ;; --- Stage B.5 D3 augmentations 2026-05-23: :mm/Shape composes with :mm/Fn by reference
  ;; per SHACL-AF sh:NodeShape + sh:SPARQLFunction composition pattern.

  {:db/ident       :mm.shape/validator-fn
   :dt/type        :dt/Property
   :dt/domain      :mm/Shape
   :dt/range       :mm/Fn
   :db/valueType   :db.type/ref
   :db/cardinality :db.cardinality/one
   :db/doc "An optional function reference contributing a check alongside the built-in shape checks. The deployed function uses :dt.fn/source-ns and :dt.fn/source-var and receives database, entity eid and shape eid. Named-reference resolution currently has a defect; verify invocation before relying on it."}

  {:db/ident       :mm.shape/value-constraints
   :dt/type        :dt/Property
   :dt/domain      :mm/Shape
   :dt/range       :mm/Fn
   :db/valueType   :db.type/ref
   :db/cardinality :db.cardinality/many
   :db/doc "Reserved references to value-constraint functions. The current sandbar.shape walker does not execute this field; it is not evidence that a value was checked."}

  ]

  ;; --- SHACL arc Stage B (2026-05-23) — :mm/Shape vocabulary expansion to SHACL-spec-aligned coverage.
  ;; Per plans/shacl_deeply_incorporated_capstone_activation_arc_2026_05_23.md §4.2.
  ;; Split into TWO batches per substrate-restart friction-discovery 2026-05-23:
  ;; Datomic can't resolve a forward-declared ident used as :dt/range value
  ;; within the same transaction batch.

  ;; Batch (i) — Sub-entity class forward decls FIRST
  [{:db/ident :mm.shape/CardinalityConstraint
    :db/doc "Forward decl: cardinality constraint on a property within a :mm/Shape (full def later)."}

   {:db/ident :mm.shape/PatternConstraint
    :db/doc "Forward decl: regex pattern constraint on a string-valued property (full def later)."}

   {:db/ident :mm.shape/DatatypeConstraint
    :db/doc "A declared datatype constraint on a property. The current shape evaluator has a permissive keyword fallback and may pass an incorrect primitive value; Datomic storage types remain a separate enforced boundary."}

   {:db/ident :mm.shape/XorConstraint
    :db/doc "Forward decl: mutual-exclusion (XOR) constraint between two slots on the same entity (full def later).  Added pre-0.2.0 β.1.A per Option ε Paired Property Pattern."}]

  ;; Batch (ii) — Slot declarations + full sub-entity class declarations.
  ;; The forward-declared idents from batch (i) are now resolvable.
  [
  ;; New scalar shape slots
  {:db/ident       :mm.shape/scope
   :dt/type        :dt/Property
   :dt/domain      :mm/Shape
   :dt/range       :db.type/keyword
   :db/valueType   :db.type/keyword
   :db/cardinality :db.cardinality/one
