    [:mm.memory/parent          11]
    [:mm.memory/part-of         12]
    [:mm.memory/has-part        13]
    [:mm.memory/descends-from   14]
    [:mm.memory/cites           15]
    [:mm.memory/evidenced-by    16]
    [:mm.memory/evidences       17]
    [:mm.memory/documented-by   18]
    [:mm.memory/documents       19]
    [:mm.memory/triggered-by    20]
    [:mm.memory/touches         21]
    [:mm.memory/motivated-by    22]
    [:mm.memory/motivates       23]
    [:mm.memory/composes-with   24]
    [:mm.memory/refines         25]
    [:mm.memory/supersedes      26]
    [:mm.memory/superseded-by   27]
    [:mm.memory/conforms-to     28]
    [:mm.memory/informs         29]
    [:mm.memory/informed-by     30]
    [:mm.memory/implements      31]
    [:mm.memory/introduced-in   32]
    [:mm.memory/related         33]
    ;; Classification tier
    [:mm.memory/themes          34]
    [:mm.memory/tags            35]
    ;; Long-tail
    [:mm.memory/frontmatter     36]]
   :dt/slots         [:mm.memory/identity :mm.memory/rel-path :mm.memory/name
                      :mm.memory/description :mm.memory/memory-type
                      :mm.memory/scope :mm.memory/status
                      :mm.memory/created :mm.memory/last-touched
                      :mm.memory/last-reviewed :mm.memory/created-by
                      :mm.memory/importance :mm.memory/tags
                      :mm.memory/themes                          ;; ADR §2.3 DCAT controlled-vocabulary tier
                      :mm.memory/frontmatter :mm.memory/first-section
                      :mm.memory/links :mm.memory/body-raw
                      ;; Typed-edge slots (sub-arc Stage 2.A; F#14 resolution)
                      :mm.memory/related :mm.memory/cites
                      :mm.memory/motivated-by :mm.memory/motivates
                      :mm.memory/composes-with :mm.memory/refines
                      :mm.memory/supersedes :mm.memory/superseded-by
                      :mm.memory/conforms-to
                      :mm.memory/part-of :mm.memory/has-part
                      :mm.memory/descends-from
                      :mm.memory/evidenced-by :mm.memory/evidences
                      :mm.memory/documented-by :mm.memory/documents
                      :mm.memory/triggered-by :mm.memory/touches
                      :mm.memory/parent
                      :mm.memory/informs :mm.memory/informed-by
                      :mm.memory/implements
                      :mm.memory/introduced-in]
   :dt/abstract?     false
   :db/doc "A corpus memorial — a markdown document under memory/ with YAML frontmatter and a markdown body.  Decomposed at multiple granularities: well-known frontmatter as direct properties; long-tail frontmatter via mm/Frontmatter; tags via mm/Tag refs; body as a sibling chain of mm/Section entities reachable via :mm.memory/first-section + :mm.section/next-sibling walk; markdown links via mm/Link refs."}]

