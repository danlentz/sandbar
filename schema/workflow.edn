;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

 [{:db/ident :workflow/definition-name
   :dt/type :dt/Property
   :dt/domain :mm/Workflow
   :dt/range :db.type/keyword
   :db/valueType :db.type/keyword
   :db/cardinality :db.cardinality/one
   :db/unique :db.unique/identity
   :db/doc "Unique identifier for this workflow (e.g., :workflow/order-fulfillment)"}

  {:db/ident :workflow/states
   :dt/type :dt/Property
   :dt/domain :mm/Workflow
   :dt/range :workflow/State
   :db/valueType :db.type/ref
   :db/cardinality :db.cardinality/many
   :db/doc "All states in this workflow"}

  {:db/ident :workflow/transitions
   :dt/type :dt/Property
   :dt/domain :mm/Workflow
   :dt/range :workflow/Transition
   :db/valueType :db.type/ref
   :db/cardinality :db.cardinality/many
   :db/doc "All valid transitions in this workflow"}

  {:db/ident :workflow/version
   :dt/type :dt/Property
   :dt/domain :mm/Workflow
   :dt/range :db.type/long
   :db/valueType :db.type/long
   :db/cardinality :db.cardinality/one
   :db/doc "Version number for workflow evolution"}]

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Process Properties
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

 [{:db/ident :workflow/definition
   :dt/type :dt/Property
   :dt/domain :workflow/Process
   :dt/range :mm/Workflow
   :db/valueType :db.type/ref
   :db/cardinality :db.cardinality/one
   :db/doc "The workflow definition this process follows"}

  {:db/ident :workflow/current-state
   :dt/type :dt/Property
   :dt/domain :workflow/Process
   :dt/range :workflow/State
   :db/valueType :db.type/ref
   :db/cardinality :db.cardinality/one
   :db/doc "Current state of this process"}

  {:db/ident :workflow/subject
   :dt/type :dt/Property
   :dt/domain :workflow/Process
   :dt/range :dt/Ref
   :db/valueType :db.type/ref
   :db/cardinality :db.cardinality/one
   :db/doc "The entity this workflow is attached to (e.g., order, ticket)"}

  {:db/ident :workflow/started-at
   :dt/type :dt/Property
   :dt/domain :workflow/Process
   :dt/range :db.type/instant
   :db/valueType :db.type/instant
   :db/cardinality :db.cardinality/one
   :db/doc "When this process was started"}

  {:db/ident :workflow/completed-at
   :dt/type :dt/Property
   :dt/domain :workflow/Process
   :dt/range :db.type/instant
   :db/valueType :db.type/instant
   :db/cardinality :db.cardinality/one
   :db/doc "When this process reached a terminal state"}

  {:db/ident :workflow/history
   :dt/type :dt/Property
   :dt/domain :workflow/Process
   :dt/range :workflow/History
   :db/valueType :db.type/ref
   :db/cardinality :db.cardinality/many
   :db/doc "Complete history of state transitions"}

  {:db/ident :workflow/process-data
   :dt/type :dt/Property
   :dt/domain :workflow/Process
   :dt/range :db.type/string
   :db/valueType :db.type/string
   :db/cardinality :db.cardinality/one
   :db/doc "Process-specific data (EDN string)"}

  ;; ι.2 substrate extension (2026-05-25) per
  ;; :memory.decisions/iota_eta_q_checkpoint_wave_one_ratification_session_workflow_substrate_design_fs_audit_scope_finalized_2026_05_25
  ;; Q.ι.6 + κ P6/P8.  Session-workflow-specific slots on :workflow/Process —
  ;; namespace-tagged :mm.session-process/* by convention; domain remains
  ;; :workflow/Process (avoids subclass proliferation per the plan's Q.ι.2.A.4
  ;; recommendation).

  {:db/ident :mm.session-process/paused-from-state
   :dt/type :dt/Property
   :dt/domain :workflow/Process
   :dt/range :db.type/keyword
   :db/valueType :db.type/keyword
   :db/cardinality :db.cardinality/one
   :db/doc "Set by :session/pause-maintenance effect (sandbar.workflow.session/on-pause-maintenance): records the pre-pause :workflow/state-name so :session/resume-maintenance can restore intent. Retracted by :session/resume-maintenance effect. Per κ P6 maintenance-mode + Q.ι.6 ratification."}

  {:db/ident :mm.session-process/failure-reason
   :dt/type :dt/Property
   :dt/domain :workflow/Process
   :dt/range :db.type/string
   :db/valueType :db.type/string
   :db/cardinality :db.cardinality/one
   :db/doc "Set by :session/fail / :session/fail-from-paused effects (sandbar.workflow.session/on-fail): free-text rationale captured at fail-time. Per κ P8 hard-fail + Q.ι.6 ratification + the :workflow/requires-reason? gate on the fail transitions."}

  {:db/ident :mm.session-process/failure-instant
   :dt/type :dt/Property
   :dt/domain :workflow/Process
   :dt/range :db.type/instant
   :db/valueType :db.type/instant
   :db/cardinality :db.cardinality/one
   :db/doc "Set by :session/fail / :session/fail-from-paused effects: wall-clock instant of the failure transition. Companion to :mm.session-process/failure-reason."}]

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; History Properties
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

 [{:db/ident :workflow/history-from
   :dt/type :dt/Property
   :dt/domain :workflow/History
   :dt/range :workflow/State
   :db/valueType :db.type/ref
   :db/cardinality :db.cardinality/one
   :db/doc "State before this transition"}

  {:db/ident :workflow/history-to
   :dt/type :dt/Property
   :dt/domain :workflow/History
   :dt/range :workflow/State
   :db/valueType :db.type/ref
   :db/cardinality :db.cardinality/one
   :db/doc "State after this transition"}

  {:db/ident :workflow/history-action
   :dt/type :dt/Property
   :dt/domain :workflow/History
   :dt/range :db.type/keyword
   :db/valueType :db.type/keyword
   :db/cardinality :db.cardinality/one
   :db/doc "Action that triggered this transition"}

  {:db/ident :workflow/history-timestamp
   :dt/type :dt/Property
   :dt/domain :workflow/History
   :dt/range :db.type/instant
   :db/valueType :db.type/instant
   :db/cardinality :db.cardinality/one
   :db/doc "When this transition occurred"}

  {:db/ident :workflow/history-actor
   :dt/type :dt/Property
   :dt/domain :workflow/History
   :dt/range :dt/Ref
   :db/valueType :db.type/ref
   :db/cardinality :db.cardinality/one
   :db/doc "Who triggered this transition"}

  {:db/ident :workflow/history-reason
   :dt/type :dt/Property
   :dt/domain :workflow/History
   :dt/range :db.type/string
