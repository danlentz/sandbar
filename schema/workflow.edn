   :db/cardinality :db.cardinality/one
   :db/doc "Reason/comment for this transition"}]

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Workflow Classes
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

 [{:db/ident :workflow/State
   :dt/type :dt/Class
   :dt/subclass-of :dt/Ref
   :dt/context "workflow"
   :dt/label "State"
   :db/doc "A named state in a workflow. States can be initial (starting point), terminal (end point), or intermediate.
            Terminal states carry a :workflow/terminal-kind classification (:success / :failure / :cancel)
            consumed by cancel-process! / can-cancel? / mcp.tasks/process->task-status."
   :dt/slots [:workflow/state-name
              :workflow/state-label
              :workflow/terminal?
              :workflow/initial?
              :workflow/terminal-kind
              :workflow/state-metadata]}

  {:db/ident :workflow/Transition
   :dt/type :dt/Class
   :dt/subclass-of :dt/Ref
   :dt/context "workflow"
   :dt/label "Transition"
   :db/doc "A valid state change triggered by an action. Can have guard functions and side effects."
   :dt/slots [:workflow/transition-name
              :workflow/from-state
              :workflow/to-state
              :workflow/guard
              :workflow/on-transition
              :workflow/requires-reason?]}

  {:db/ident :mm/Workflow
   :dt/type :dt/Class
   :dt/subclass-of :mm/Meta             ;; Stage C of first-class-memorialization arc: changed from :dt/Ref to :mm/Meta (mirrors :mm/Session precedent) — inherits :mm/Memory slot family for fs projection
   :dt/context "workflow"
   :dt/label "Definition"
   :dt/memorial-policy :first-class       ;; user-visible behavioral spec — projects to memory/workflows/<name>.md per first-class-memorialization arc Stage E migration
   :db/doc "A complete workflow specification with states and transitions.  Per Stage C of `plans/sandbar_first_class_memorialization_arc_workflows_schedules_contexts_dt_memorial_policy_2026_05_23.md` — class now inherits from `:mm/Meta` (a `:mm/Memory` descendant) so workflow definitions are first-class memorialized like sessions / decisions / plans.  Codec emit (states + transitions sections) lands in Stage D; until then projection sink skips workflows with `:no-native-codec` reason."
   :dt/slots [:workflow/definition-name
              :workflow/states
              :workflow/transitions
              :workflow/version]}

  {:db/ident :workflow/Process
   :dt/type :dt/Class
   :dt/subclass-of :dt/Ref
   :dt/context "workflow"
   :dt/label "Process"
   :dt/memorial-policy :db-only           ;; runtime state — covered by DB-dump arc for disaster recovery + audit
   :db/doc "A running instance of a workflow attached to a subject entity."
   :dt/slots [:workflow/definition
              :workflow/current-state
              :workflow/subject
              :workflow/started-at
              :workflow/completed-at
              :workflow/history
              :workflow/process-data]}

  {:db/ident :workflow/History
   :dt/type :dt/Class
   :dt/subclass-of :dt/Ref
   :dt/context "workflow"
   :dt/label "History"
   :db/doc "A record of a single state transition in a process."
   :dt/slots [:workflow/history-from
              :workflow/history-to
              :workflow/history-action
              :workflow/history-timestamp
              :workflow/history-actor
              :workflow/history-reason]}]

]
