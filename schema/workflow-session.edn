;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; workflow-session.edn — :workflow/session lifecycle definition (ι.2 substrate)
;;
;; First-class source-of-truth EDN for the session-orientation workflow.  Per
;; :memory.decisions/iota_eta_q_checkpoint_wave_one_ratification_session_workflow_substrate_design_fs_audit_scope_finalized_2026_05_25
;; Q.ι.4 (EDN file source-of-truth) + Q.ι.6 (add :session/paused + :session/failed
;; states) + Q.ι.13 (transition guards/effects as :mm/Fn entities) + Q.ι.14
;; (dual-source history) + Q.ι.15 (STRICT Event Substrate ADR compliance).
;;
;; Composes with κ pattern catalog:
;;   P5 schema-as-data; P6 engine-respected maintenance-mode flag; P7 step/
;;   jump/resume/pause verb family; P8 hard-fail flag; P10 history-as-events;
;;   P17 metrics-event vocabulary.
;;
;; Pre-existing :workflow/session in DB (introduced 2026-05-22 per
;; decisions/session_lifecycle_mcp_native_rebuild_q1_q2_q3_q4_resolved_plus_slash_command_deprecation_dan_directive_2026_05_22):
;;   4 states (:session/opening initial → :session/active → :session/closing →
;;   :session/closed terminal :success) + 5 transitions (:session/start /
;;   :session/pause active→opening / :session/resume opening→active /
;;   :session/close / :session/finalize).  Was seeded via MCP workflow_define
;;   verb; no static source-of-truth.
;;
;; This file establishes the static source-of-truth + extends additively:
;;   2 NEW states (:session/paused for maintenance-mode + :session/failed for
;;   hard-fail) + 4 NEW transitions (:session/pause-maintenance active→paused /
;;   :session/resume-maintenance paused→active / :session/fail active→failed /
;;   :session/fail-from-paused paused→failed).  Existing :session/pause +
;;   :session/resume preserved unchanged (now functioning as deprecated-but-
;;   working ad-hoc pause-to-opening idiom).
;;
;; Idempotency: state entities upsert by :workflow/state-name :db.unique/
;; identity; transition entities use explicit :db/ident for stable reference;
;; workflow entity upserts by :db/ident :workflow/session.  Re-running schema-
;; load is safe.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

[

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; STATE ENTITIES (6 total — 4 existing upserted + 2 new)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

[{:workflow/state-name :session/opening
  :dt/type :workflow/State
  :workflow/state-label "Opening"
  :workflow/initial? true}

 {:workflow/state-name :session/active
  :dt/type :workflow/State
  :workflow/state-label "Active"}

 ;; NEW per Q.ι.6 — dedicated maintenance-mode pause state (κ P6).
 {:workflow/state-name :session/paused
  :dt/type :workflow/State
  :workflow/state-label "Paused (maintenance-mode)"
  :workflow/state-metadata "{:maintenance-mode true :resume-target :session/active :resumes-via :session/resume-maintenance}"}

 {:workflow/state-name :session/closing
  :dt/type :workflow/State
  :workflow/state-label "Closing"}

 {:workflow/state-name :session/closed
  :dt/type :workflow/State
  :workflow/state-label "Closed (success)"
  :workflow/terminal? true
  :workflow/terminal-kind :success}

 ;; NEW per Q.ι.6 + κ P8 — terminal hard-fail state.
 {:workflow/state-name :session/failed
  :dt/type :workflow/State
  :workflow/state-label "Failed (non-recoverable)"
  :workflow/terminal? true
  :workflow/terminal-kind :failure}]

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; TRANSITION ENTITIES (9 total — 5 original + 4 new).
;;
;; The 5 ORIGINAL transitions (:session/start / :session/pause active→opening /
;; :session/resume opening→active / :session/close / :session/finalize) were
;; originally seeded via MCP `workflow_define` 2026-05-22 without static EDN.
;; This session's substrate-gap work (2026-05-26) backfilled `:db/ident`
;; `:session.transition/<verb>` on those 5 in production DB; this EDN now
;; canonicalizes those declarations + the 4 ι.2 additions as the single
;; source-of-truth so a fresh DB load reproduces the COMPLETE workflow.
;; Datomic ident-upsert semantics ensure idempotency — re-loading against
;; a production DB that already has these transitions is a no-op.
;;
;; ORIGINAL preservation note: the legacy `:session/pause` / `:session/resume`
;; pair (active ↔ opening) is RETAINED as deprecated-but-working idiom per
;; the ι.2 EDN comment; new code should use the κ P6 maintenance-mode pair
;; (`:session/pause-maintenance` / `:session/resume-maintenance` — active ↔ paused).
;;
;; Same-name ambiguity AVOIDED: each transition has a distinct
;; :workflow/transition-name keyword + distinct :db/ident.  No clashes with
;; the 4 NEW ι.2 transitions.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

[;; ORIGINAL — start the session (opening → active).
 {:db/ident :session.transition/start
  :workflow/transition-name :session/start
  :dt/type :workflow/Transition
  :workflow/from-state [:workflow/state-name :session/opening]
  :workflow/to-state [:workflow/state-name :session/active]}

 ;; ORIGINAL — deprecated ad-hoc pause (active → opening).  Retained as
 ;; historical idiom; new code uses :session.transition/pause-maintenance
 ;; (active → paused) instead.  Per κ P6 maintenance-mode discipline.
 {:db/ident :session.transition/pause
  :workflow/transition-name :session/pause
  :dt/type :workflow/Transition
  :workflow/from-state [:workflow/state-name :session/active]
  :workflow/to-state [:workflow/state-name :session/opening]}

 ;; ORIGINAL — deprecated ad-hoc resume (opening → active).  Retained as
 ;; historical idiom; pairs with :session.transition/pause above.
 {:db/ident :session.transition/resume
  :workflow/transition-name :session/resume
  :dt/type :workflow/Transition
  :workflow/from-state [:workflow/state-name :session/opening]
  :workflow/to-state [:workflow/state-name :session/active]}

 ;; ORIGINAL — close the session (active → closing).
 {:db/ident :session.transition/close
  :workflow/transition-name :session/close
  :dt/type :workflow/Transition
  :workflow/from-state [:workflow/state-name :session/active]
  :workflow/to-state [:workflow/state-name :session/closing]}

 ;; ORIGINAL — finalize the session (closing → closed terminal :success).
 {:db/ident :session.transition/finalize
  :workflow/transition-name :session/finalize
  :dt/type :workflow/Transition
  :workflow/from-state [:workflow/state-name :session/closing]
  :workflow/to-state [:workflow/state-name :session/closed]}

 ;; NEW per κ P6 — maintenance-mode pause (active → paused).
 {:db/ident :session.transition/pause-maintenance
  :workflow/transition-name :session/pause-maintenance
  :dt/type :workflow/Transition
  :workflow/from-state [:workflow/state-name :session/active]
  :workflow/to-state [:workflow/state-name :session/paused]
  :workflow/guard sandbar.workflow.session/can-pause-maintenance?
  :workflow/on-transition sandbar.workflow.session/on-pause-maintenance
  :workflow/requires-reason? true}

 ;; NEW per κ P6 — maintenance-mode resume (paused → active).
 {:db/ident :session.transition/resume-maintenance
  :workflow/transition-name :session/resume-maintenance
  :dt/type :workflow/Transition
  :workflow/from-state [:workflow/state-name :session/paused]
  :workflow/to-state [:workflow/state-name :session/active]
  :workflow/on-transition sandbar.workflow.session/on-resume-maintenance}

 ;; NEW per κ P8 — non-recoverable abort from active.
 {:db/ident :session.transition/fail
  :workflow/transition-name :session/fail
  :dt/type :workflow/Transition
  :workflow/from-state [:workflow/state-name :session/active]
  :workflow/to-state [:workflow/state-name :session/failed]
  :workflow/on-transition sandbar.workflow.session/on-fail
  :workflow/requires-reason? true}

 ;; NEW — fail-while-in-maintenance (paused → failed).  Operators in
 ;; maintenance-mode can give up on a session without resuming first.
 {:db/ident :session.transition/fail-from-paused
  :workflow/transition-name :session/fail-from-paused
  :dt/type :workflow/Transition
  :workflow/from-state [:workflow/state-name :session/paused]
  :workflow/to-state [:workflow/state-name :session/failed]
  :workflow/on-transition sandbar.workflow.session/on-fail
  :workflow/requires-reason? true}

 ;; NEW per W4.1 Increment E (κ P8 :phase-timeout hard-fail detection)
 ;; — fail-while-still-opening (opening → failed).  Required for the ι.3
 ;; orchestrator to advance the process to :session/failed when a phase-
 ;; timeout fires DURING the :phase/activate boundary (which transitions
 ;; opening → active).  Without this transition the orchestrator can emit
 ;; :mm.event/WorkflowSessionFailed observability but the process is
 ;; stuck in :opening because no fail-shaped transition is reachable.
 ;; Per ι.3 design ratification ADR §Q.ι.3.4 (4 hard-fail conditions).
 {:db/ident :session.transition/fail-from-opening
  :workflow/transition-name :session/fail-from-opening
  :dt/type :workflow/Transition
  :workflow/from-state [:workflow/state-name :session/opening]
  :workflow/to-state [:workflow/state-name :session/failed]
  :workflow/on-transition sandbar.workflow.session/on-fail
  :workflow/requires-reason? true}]

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; WORKFLOW DEFINITION (1) — upsert by :db/ident :workflow/session.  Datomic
;; cardinality-many merges :workflow/states + :workflow/transitions with the
;; existing 4 states + 5 transitions.  After this load: 6 states + 9 transitions
;; (the 5 existing + 4 new) reachable from the workflow.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

[{:db/ident :workflow/session
  :dt/type :mm/Workflow
  :workflow/definition-name :workflow/session
  :workflow/states [[:workflow/state-name :session/opening]
                    [:workflow/state-name :session/active]
                    [:workflow/state-name :session/paused]
                    [:workflow/state-name :session/closing]
                    [:workflow/state-name :session/closed]
                    [:workflow/state-name :session/failed]]
  :workflow/transitions [;; 5 original (canonicalized in EDN this session per W4.1
                         ;; orchestrate-tests-require-complete-fresh-db-workflow):
                         :session.transition/start
                         :session.transition/pause
                         :session.transition/resume
                         :session.transition/close
                         :session.transition/finalize
                         ;; 4 ι.2 additions per Q.ι.6:
                         :session.transition/pause-maintenance
                         :session.transition/resume-maintenance
                         :session.transition/fail
                         :session.transition/fail-from-paused
                         ;; W4.1 Increment E: phase-timeout fail-shape coverage
                         :session.transition/fail-from-opening]
  :workflow/version 2
  :mm.memory/name "Session-Orientation Workflow"
  :mm.memory/description "Lifecycle workflow for AI-collaboration sessions. Opens with :session/start (transitioning the initial :session/opening state to :session/active), supports :session/pause-maintenance / :session/resume-maintenance for κ-P6 maintenance-mode pause-without-destroy (active ↔ paused state), and :session/fail / :session/fail-from-paused for κ-P8 non-recoverable abort. Closes with :session/close → :session/finalize chain. Per the wave-1 ratification ADR + the ι sub-arc plan. Existing :session/pause / :session/resume transitions (active ↔ opening) preserved unchanged as deprecated ad-hoc pause idiom; new code uses the :session/pause-maintenance pair."
  :mm.memory/rel-path "workflows/session.md"
  :mm.memory/memory-type :workflow
  :mm.memory/scope :global}]

]
