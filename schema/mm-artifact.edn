  {:db/ident :mm/Reference    :db/doc "Forward declaration; full class definition later in this file."}
  {:db/ident :mm/Resource     :db/doc "Forward declaration; sub-subtype of Reference; full class definition later in this file."}
  {:db/ident :mm/ContentType  :db/doc "Forward declaration; sub-subtype of Reference; full class definition later in this file."}
  {:db/ident :mm/Memoir       :db/doc "Forward declaration; full class definition later in this file."}
