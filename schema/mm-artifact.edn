;; Class Definitions — concrete Artifact subtypes (12)
;;
;; Order: simple first (no slots), then incrementally richer.
;; Reference → Resource + ContentType form the 4-level inheritance chain.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

 [{:db/ident             :mm/Decision
   :dt/type              :dt/Class
   :dt/subclass-of       :mm/Artifact
   :dt/context           "mm"
   :dt/label             "Decision"
   :dt/native-codec      :markdown
   :dt/abstract?         false
   :db/doc "Architectural choice captured with alternatives, rationale, and acceptance — ADR shape.  Per memory/types/decision.md.  Body sections: Context / Decision / Alternatives considered / Rationale / Consequences / See also.  Captureable: mid-conversation-captureable: true; inject-trigger: 'the right answer is X over Y because', 'we should X because'; inject-class: 'Decision-worthy'; audit-class: 'decision'.  Audit invariant: 'decision names alternatives' (warning).  Tier: expanding-periphery."}

  {:db/ident             :mm/Library
   :dt/type              :dt/Class
   :dt/subclass-of       :mm/Artifact
