;; Editorial labels for the optional client affordance table. Counts and axes
;; come from the catalog model; descriptions and presentation order live here.
;; A new axis without an editorial entry fails generation for explicit review.

{:order [:entity :search :navigate :aggregate :ground :orient :workflow :tools
         :tag :schedule :class :validation :shape :schema :property :types
         :project :codec :namespace :reactive :audit :resolve]

 :axes
 {:entity     {:reach-for "read/write ONE memory by ident or rel-path — find · find-by-rel-path · create · update · validate · retract"
               :schema "EAGER"}
  :search     {:reach-for "retrieve by query — `bm25f` (weighted multi-field NL) · `attribute` (single-field Lucene)"
               :schema "EAGER"}
  :navigate   {:reach-for "walk typed edges — outbound/inbound-edges · siblings-of · path-via"
               :schema "EAGER"}
  :aggregate  {:reach-for "rollups — count · group-by · rank-by · tag-histogram"
               :schema "EAGER"}
  :ground     {:reach-for "vocabulary lookup and model context before introducing a concept"
               :schema "EAGER"}
  :orient     {:reach-for "synthesized views — library-card *(EAGER)* · tree · type-tree *(LAZY)*"
               :schema "mixed"}
  :workflow   {:reach-for "session/process lifecycle — orchestrate · start-process/transition · process-state/history · active-processes · define/find"
               :schema "EAGER core"}
  :tools      {:reach-for "META-verbs over the catalog — `search` (rank verbs for a task) · `describe` (full card + composition edges for one verb)"
               :schema "LAZY"}
  :tag        {:reach-for "**tag-vocabulary curation** — lookup · define · audit · consolidate(-all) · align · harmonize · rename · split"
               :schema "LAZY"}
  :schedule   {:reach-for "γ scheduler — enable/disable · start/stop · add/remove · list · inspect (recurring jobs)"
               :schema "LAZY"}
  :class      {:reach-for "class introspection — describe · slots · direct/required-slots · instances · subclasses · parents · validate-all-instances"
               :schema "LAZY"}
  :validation {:reach-for "validation workflow — start · run · results · cancel · retry · history"
               :schema "LAZY"}
  :shape      {:reach-for "SHACL shapes — create · list · update · validate · conformance-report"
               :schema "LAZY"}
  :schema     {:reach-for "enumerate the schema surface — classes · properties · entities · datatypes"
               :schema "LAZY"}
  :property   {:reach-for "predicate introspection — domain · range · cardinality"
               :schema "LAZY"}
  :types      {:reach-for "type-relation checks — instance-of · subclass-of"
               :schema "LAZY"}
  :project    {:reach-for "bulk project I/O — export · import"
               :schema "LAZY"}
  :codec      {:reach-for "codec inspection — list"
               :schema "LAZY"}
  :namespace  {:reach-for "namespace-policy governance"
               :schema "LAZY"}
  :reactive   {:reach-for "reactive-projection queue health"
               :schema "LAZY"}
  :audit      {:reach-for "FS↔substrate drift detection"
               :schema "LAZY"}
  :resolve    {:reach-for "resolve an ambiguous entity-ref"
               :schema "LAZY"}}}
